reak%2FaRYByLpReVYa4cH1_image-58-.png%3Fauto%3Dformat%2Ccompress&amp;w=1080&amp;q=75"/></div><p class="sc-eifrsQ cwTQkz sc-OIPhM ckjoOa" data-testid="headline">Credit Card Debt Consolidation Explained</p><p class="sc-gEvEer fcWSbJ sc-fHsjty gSvrVh" data-testid="text">November 13, 2025</p></a></div><div data-testid="articles-article-item" class="sc-jztukc ikVSEK"><a data-testid="link-read-more" href="/articles/credit-check-in-2025" class="sc-jhJOaJ bSwziI"><div class="sc-behkuB clrxSx"><img alt="Financial Education" loading="lazy" width="450" height="290" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2Fa7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial%2BEducation%2B%2528Define%2Bit%2529.png%3Fauto%3Dformat%2Ccompress&amp;w=640&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2Fa7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial%2BEducation%2B%2528Define%2Bit%2529.png%3Fauto%3Dformat%2Ccompress&amp;w=1080&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2Fa7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial%2BEducation%2B%2528Define%2Bit%2529.png%3Fauto%3Dformat%2Ccompress&amp;w=1080&amp;q=75"/></div><p class="sc-eifrsQ cwTQkz sc-OIPhM ckjoOa" data-testid="headline">The 2025 Credit Check-In by Happy Money®</p><p class="sc-gEvEer fcWSbJ sc-fHsjty gSvrVh" data-testid="text">August 12, 2025</p></a></div><div data-testid="articles-article-item" class="sc-jztukc ikVSEK"><a data-testid="link-read-more" href="/articles/what-is-the-30-day-rule-for-personal-finance" class="sc-jhJOaJ bSwziI"><div class="sc-behkuB bFsifl"><img alt="Financial Education" loading="lazy" width="450" height="290" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2Fa7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial%2BEducation%2B%2528Define%2Bit%2529.png%3Fauto%3Dcompress%2Cformat&amp;w=640&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2Fa7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial%2BEducation%2B%2528Define%2Bit%2529.png%3Fauto%3Dcompress%2Cformat&amp;w=1080&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2Fa7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial%2BEducation%2B%2528Define%2Bit%2529.png%3Fauto%3Dcompress%2Cformat&amp;w=1080&amp;q=75"/></div><p class="sc-eifrsQ cwTQkz sc-OIPhM ckjoOa" data-testid="headline">What Is the 30 Day Rule for Personal Finance?</p><p class="sc-gEvEer fcWSbJ sc-fHsjty gSvrVh" data-testid="text">May 3, 2025</p></a></div><div data-testid="articles-article-item" class="sc-jztukc ikVSEK"><a data-testid="link-read-more" href="/articles/what-makes-up-your-credit-score" class="sc-jhJOaJ bSwziI"><div class="sc-behkuB VnuWz"><img alt="Makes Up Your Credit Score" loading="lazy" width="450" height="290" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2Fa7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial%2BEducation%2B%2528Define%2Bit%2529.png%3Fauto%3Dcompress%2Cformat&amp;w=640&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2Fa7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial%2BEducation%2B%2528Define%2Bit%2529.png%3Fauto%3Dcompress%2Cformat&amp;w=1080&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2Fa7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial%2BEducation%2B%2528Define%2Bit%2529.png%3Fauto%3Dcompress%2Cformat&amp;w=1080&amp;q=75"/></div><p class="sc-eifrsQ cwTQkz sc-OIPhM ckjoOa" data-testid="headline">What Makes Up Your Credit Score?</p><p class="sc-gEvEer fcWSbJ sc-fHsjty gSvrVh" data-testid="text">April 4, 2025</p></a></div><div data-testid="articles-article-item" class="sc-jztukc ikVSEK"><a data-testid="link-read-more" href="/articles/what-is-an-unsecured-vs-secured-personal-loan" class="sc-jhJOaJ bSwziI"><div class="sc-behkuB clrxSx"><img alt="Unsecured vs. Secured Personal Loan" loading="lazy" width="450" height="290" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2FZ_OBYndAxsiBwYT4_Financial%252BEducation%252B-Define%252Bit-.webp%3Fauto%3Dformat%2Ccompress&amp;w=640&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2FZ_OBYndAxsiBwYT4_Financial%252BEducation%252B-Define%252Bit-.webp%3Fauto%3Dformat%2Ccompress&amp;w=1080&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2FZ_OBYndAxsiBwYT4_Financial%252BEducation%252B-Define%252Bit-.webp%3Fauto%3Dformat%2Ccompress&amp;w=1080&amp;q=75"/></div><p class="sc-eifrsQ cwTQkz sc-OIPhM ckjoOa" data-testid="headline">What Is an Unsecured vs. Secured Personal Loan?</p><p class="sc-gEvEer fcWSbJ sc-fHsjty gSvrVh" data-testid="text">February 12, 2025</p></a></div><div data-testid="articles-article-item" class="sc-jztukc ikVSEK"><a data-testid="link-read-more" href="/articles/types-of-debt-how-credit-mix-affects-your-credit-score" class="sc-jhJOaJ bSwziI"><div class="sc-behkuB kmePkc"><img alt="How Credit Mix Affects Your Credit Score" loading="lazy" width="450" height="290" decoding="async" data-nimg="1" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2FZ_OBYndAxsiBwYT4_Financial%252BEducation%252B-Define%252Bit-.webp%3Fauto%3Dformat%2Ccompress&amp;w=640&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2FZ_OBYndAxsiBwYT4_Financial%252BEducation%252B-Define%252Bit-.webp%3Fauto%3Dformat%2Ccompress&amp;w=1080&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fimages.prismic.io%2Fpoint-break%2FZ_OBYndAxsiBwYT4_Financial%252BEducation%252B-Define%252Bit-.webp%3Fauto%3Dformat%2Ccompress&amp;w=1080&amp;q=75"/></div><p class="sc-eifrsQ cwTQkz sc-OIPhM ckjoOa" data-testid="headline">Types of Debt: How Credit Mix Affects Your Credit Score</p><p class="sc-gEvEer fcWSbJ sc-fHsjty gSvrVh" data-testid="text">January 18, 2025</p></a></div></div><button data-testid="load-more-button" aria-label="view-more-articles" class="sc-kgvGAC hVHjhs">View More</button></div></section></main><footer class="sc-kOHTFB iqujDu"><div class="sc-bmzYkS hWsPxy"><div class="sc-kOPcWz kkuoQY"><div><a href="/"><img alt="HM Logo" loading="lazy" width="243" height="34" decoding="async" data-nimg="1" class="sc-dCFHLb hlZGZK" style="color:transparent" src="/hm-logo--white.svg"/></a><div class="sc-cWSHoV YHdmc"><a target="_blank" rel="noreferrer" href="https://www.facebook.com/happymoney/" class="sc-iHGNWf kaIMHZ"><img alt="facebook" loading="lazy" width="20" height="20" decoding="async" data-nimg="1" style="color:transparent" src="/social/facebook.svg"/></a><a target="_blank" rel="noreferrer" href="https://www.instagram.com/happymoney/?hl=en" class="sc-iHGNWf kaIMHZ"><img alt="instagram" loading="lazy" width="20" height="20" decoding="async" data-nimg="1" style="color:transparent" src="/social/instagram.svg"/></a><a target="_blank" rel="noreferrer" href="https://twitter.com/happymoney" class="sc-iHGNWf kaIMHZ"><img alt="twitter" loading="lazy" width="20" height="20" decoding="async" data-nimg="1" style="color:transparent" src="/social/twitter.svg"/></a><a target="_blank" rel="noreferrer" href="https://www.linkedin.com/company/happy-money" class="sc-iHGNWf kaIMHZ"><img alt="linkedin" loading="lazy" width="20" height="20" decoding="async" data-nimg="1" style="color:transparent" src="/social/linkedin.svg"/></a></div></div><div class="sc-eeDRCY bMkBfI"><ul class="sc-koXPp jisjhG"></ul><ul class="sc-koXPp jisjhG"><li class="sc-jsJBEP gAsjVS"><h3 class="sc-bXCLTC kXGHKo">Our Company</h3></li><li class="sc-jsJBEP gAsjVS"><a data-testid="footer-link-company" href="/company" class="sc-hmdomO gELTHU">Company</a></li><li class="sc-jsJBEP gAsjVS"><a data-testid="footer-link-careers" href="/careers" class="sc-hmdomO gELTHU">Careers</a></li><li class="sc-jsJBEP gAsjVS"><a data-testid="footer-link-press" href="/press" class="sc-hmdomO gELTHU">Press</a></li></ul><ul class="sc-koXPp jisjhG"><li class="sc-jsJBEP gAsjVS"><h3 class="sc-bXCLTC kXGHKo">Help Center</h3></li><li class="sc-jsJBEP gAsjVS"><a data-testid="footer-link-contact-us" href="/contact" class="sc-hmdomO gELTHU">Contact Us</a></li><li class="sc-jsJBEP gAsjVS"><a target="_blank" rel="noreferrer" data-testid="footer-link-support-↗" href="https://happymoney.com/support" class="sc-hmdomO gELTHU">Support ↗</a></li><li class="sc-jsJBEP gAsjVS"><a target="_blank" rel="noreferrer nofollow" data-testid="footer-link-opt-out-↗" href="https://cloud.e.happymoney.com/preferences" class="sc-hmdomO gELTHU">Opt Out ↗</a></li></ul><ul class="sc-koXPp jisjhG"><li class="sc-jsJBEP gAsjVS"><h3 class="sc-bXCLTC kXGHKo">Legal</h3></li><li class="sc-jsJBEP gAsjVS"><a data-testid="footer-link-privacy-&amp;-legal" href="/privacy-and-legal" class="sc-hmdomO gELTHU">Privacy &amp; Legal</a></li><li class="sc-jsJBEP gAsjVS"><a data-testid="footer-link-licenses" href="/lending-licenses" class="sc-hmdomO gELTHU">Licenses</a></li><li class="sc-jsJBEP gAsjVS"><a data-testid="footer-link-all-lending-partners" href="/all-lending-partners" class="sc-hmdomO gELTHU">All Lending Partners</a></li><li class="sc-jsJBEP gAsjVS"><a data-testid="footer-link-accessibility" href="/contact#accessibility" class="sc-hmdomO gELTHU">Accessibility</a></li></ul></div></div><hr class="sc-eBMEME fhTlDQ"/><div class="sc-fHjqPf hisCxf"><img alt="nortonSecured" loading="lazy" width="67" height="28" decoding="async" data-nimg="1" style="color:transparent;max-width:100%;height:auto" src="/securityLogos/nortonSecured.svg"/><img alt="mcAfee" loading="lazy" width="67" height="24" decoding="async" data-nimg="1" style="color:transparent;max-width:100%;height:auto" src="/securityLogos/mcAfee.svg"/><img alt="bbb" loading="lazy" width="67" height="26" decoding="async" data-nimg="1" style="color:transparent;max-width:100%;height:auto" src="/securityLogos/bbb.svg"/></div><div class="sc-fhzFiK cEdpWr"></div><div class="sc-dtInlm kFFoG"><a data-testid="footer-copy-trust-and-security" href="/trust-and-security" class="sc-dtBdUo eHtheE">Trust and Security</a><a data-testid="footer-copy-privacy-policy" href="/privacy-policy" class="sc-dtBdUo eHtheE">Privacy Policy</a><a target="_blank" rel="noreferrer" data-testid="footer-copy-nmls-consumer-access" href="https://nationwidelicensingsystem.org/about/Pages/NMLSConsumerAccess.aspx" class="sc-dtBdUo eHtheE">NMLS #1396805 (NMLS Consumer Access ↗)</a><p class="sc-jxOSlx bsVqAM">© Copyright <!-- -->2025<!-- -->. All rights reserved. Happy Money, Inc.</p></div></div></footer></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"data":[{"id":"aQj3DxkAAEMABByF","uid":"credit-card-debt-consolidation-explained","url":null,"type":"blog","href":"https://point-break.cdn.prismic.io/api/v2/documents/search?ref=aTca7RkAAEIASeXF\u0026q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aQj3DxkAAEMABByF%22%29+%5D%5D","tags":["11032025","11032025 - new","11042025","11132025 - Update Image"],"first_publication_date":"2025-11-03T18:40:37+0000","last_publication_date":"2025-11-13T16:07:48+0000","slugs":["credit-card-debt-consolidation-explained"],"linked_documents":[],"lang":"en-us","alternate_languages":[],"data":{"seo_title":"Credit Card Debt Consolidation Explained","seo_description":"Credit Card Debt Consolidation Explained","title":[{"type":"heading1","text":"Credit Card Debt Consolidation Explained","spans":[],"direction":"ltr"}],"category":"money","author":"Happy Money","bg_color":"#FFD28F - Golden Hour","publish_date":"2025-11-13","image":{"dimensions":{"width":5414,"height":3080},"alt":"Consolidated Debt ","copyright":null,"url":"https://images.prismic.io/point-break/aRYByLpReVYa4cH1_image-58-.png?auto=format,compress","id":"aRYByLpReVYa4cH1","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"},"Mobile":{"dimensions":{"width":100,"height":100},"alt":"Consolidated Debt ","copyright":null,"url":"https://images.prismic.io/point-break/aRYByLpReVYa4cH1_image-58-.png?auto=format,compress\u0026rect=1167,0,3080,3080\u0026w=100\u0026h=100","id":"aRYByLpReVYa4cH1","edit":{"x":1167,"y":0,"zoom":1,"background":"transparent"}}},"content":[{"type":"paragraph","text":"Credit card debt consolidation is the process of combining multiple credit card balances into a single repayment method. Unlike general debt consolidation, which can include medical bills or other types of personal loans, this strategy focuses specifically on paying off revolving credit card balances. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"The goal is to replace high-interest card payments with one structured plan—often through a personal loan, balance transfer, or another consolidation tool—that makes repayment more predictable and potentially less expensive.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Now that you understand the basics, let’s explore how credit card debt consolidation works.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"How Does Credit Card Debt Consolidation Work?","spans":[{"start":0,"end":45,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Here’s how the process works to consolidate your credit card debt:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Step 1: Review your debt. Assess your credit card debt, including total balance and interest rates.","spans":[{"start":0,"end":25,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Step 2: Pick your method. Choose a consolidation method, such as applying for a personal loan or transferring balances.","spans":[{"start":0,"end":25,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Step 3: Pay off your cards. Use the new loan or balance transfer to clear your existing cards.","spans":[{"start":0,"end":27,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Step 4: Repay under your new loan terms. Make one monthly payment toward your consolidated balance.","spans":[{"start":0,"end":40,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"For example, you might consolidate $10,000 across three cards into one personal loan, simplifying your monthly payment.That’s exactly what The Payoff Loan™ was designed to do.","spans":[{"start":138,"end":155,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/payoff-loan","target":"_blank"}}],"direction":"ltr"},{"type":"paragraph","text":"Benefits of Credit Card Debt Consolidation","spans":[{"start":0,"end":42,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Consolidating credit card debt can make repayment easier and more affordable. Here are the benefits:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Lower interest costs: Credit card APRs often top 20%. A personal loan or balance transfer can reduce what you pay in interest. ","spans":[{"start":0,"end":20,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Single due date: Fewer bills to track means less stress and a lower chance of late fees. Consolidation simplifies your financial obligation to one monthly payment.","spans":[{"start":0,"end":15,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Clear payoff timeline: Unlike revolving balances, consolidation loans have fixed payoff timeliness so you can see real progress toward being debt-free.","spans":[{"start":0,"end":21,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Support for your credit health: Consistent on-time payments can help improve your score over time by lowering utilization across multiple cards..","spans":[{"start":0,"end":30,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Consolidation can save you money, simplify your life, and give you a repayment plan that feels achievable.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Potential Considerations to Keep in Mind","spans":[{"start":0,"end":40,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"While credit card debt consolidation can create a clearer repayment path, it is not without important considerations:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Fees and costs: Balance transfer may come with fees, and some personal loans may include origination fees.","spans":[{"start":0,"end":14,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Credit requirements: The best rates usually go to those with stronger credit score and history.","spans":[{"start":0,"end":19,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Temptation to spend again: Unlike installment loans, credit card debt is revolving, meaning old or paid off accounts remain open and reusable. If balances are run up again, progress from consolidation can quickly be undone.","spans":[{"start":0,"end":25,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Longer repayment: Stretching out a loan term may lower your monthly payment but can increase total interest paid over time.","spans":[{"start":0,"end":16,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"When Credit Card Debt Consolidation Makes Sense","spans":[{"start":0,"end":47,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Credit card debt consolidation is most effective when it reduces costs and simplifies repayment. It’s often a good fit if: ","spans":[],"direction":"ltr"},{"type":"list-item","text":"Your credit card APRs are higher than the rates you could qualify for with a loan or balance transfer.","spans":[],"direction":"ltr"},{"type":"list-item","text":"You’re juggling multiple due dates and want one simple payment.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Your credit score and history can qualify you for lower rates and better terms.","spans":[],"direction":"ltr"},{"type":"list-item","text":"You can commit to repayment.","spans":[],"direction":"ltr"},{"type":"list-item","text":"You’re ready to make lasting changes to how you manage credit. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Top Credit Card Debt Consolidation Options","spans":[{"start":0,"end":42,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"When these factors line up consolidation can help replace scattered debt with a clear payoff strategy. Next, let’s look at the leading consolidation options available.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"The main options for managing credit card debt generally fall into three categories: a personal loan, a balance transfer card, or a debt management program. Each method has its own advantages and trade-offs, and the best fit depends on your budget, your credit profile, and how quickly you want to pay off your balances.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Here’s a comparison of the top credit card debt consolidation options:","spans":[],"direction":"ltr"},{"type":"image","url":"https://images.prismic.io/point-break/aPJN_55xUNkB2GRB_Screenshot2025-10-17at10.05.18AM.png?auto=format,compress","alt":"Comparison Debt Consolidation Options","copyright":null,"dimensions":{"width":1372,"height":520},"id":"aPJN_55xUNkB2GRB","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},{"type":"paragraph","text":"No single method is right for everyone, so it's important to find the best fit for your situation. A personal loan provides fixed payments and a clear payoff date, which many borrowers find easier to manage. A balance transfer can offer short-term relief if you can pay down debt during the introductory period. Debt management programs may help those who need structured support and reduced rates.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"By carefully weighing personal loans against other financial options, you can choose the best path to simplify your payments and reduce the burden of credit card debt.","spans":[{"start":22,"end":68,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/personal-loan/vs-other-options","target":"_blank"}}],"direction":"ltr"},{"type":"paragraph","text":"Common Consolidation Mistakes to Avoid","spans":[{"start":0,"end":38,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"To get the most out of consolidation, avoid these common pitfalls:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Treating consolidation like a reset button: Don’t run up balances on newly cleared cards. Spending within your means is a smart money move.","spans":[{"start":0,"end":42,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Ignoring your budget: Without a plan to control spending, balances may creep back up despite lower payments. Support your budget with wise financial strategies so you feel confident in sticking to your goals.","spans":[{"start":0,"end":20,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Focusing only on your monthly payment: A lower monthly bill can sometimes mean higher long-term costs, so consider all the factors in your loan terms.","spans":[{"start":0,"end":37,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Picking the wrong repayment structure: A balance transfer only helps if you can pay it off before the promotional period ends.","spans":[{"start":0,"end":37,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"By avoiding these mistakes, you can approach consolidation with more clarity and confidence. For many people, a well-structured personal loan offers predictability and long-term savings, making it one of the most reliable ways to manage debt effectively.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"How to Compare Credit Card Consolidation Options","spans":[{"start":0,"end":48,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"When choosing between personal loans, balance transfers, or other tools, it’s important to look beyond the headline rate. Be sure to compare them on the same terms:","spans":[],"direction":"ltr"},{"type":"o-list-item","text":"Match to your goals: Do you want fixed payments and a defined payoff date, or short-term relief with a balance transfer?. Debt management programs may suit you if you want coaching and negotiated rates.","spans":[{"start":0,"end":19,"type":"strong"}],"direction":"ltr"},{"type":"o-list-item","text":"Look at the true cost: Compare total repayment, including interest, fees, and repayment terms. Estimate total repayment so you can compare options apples to apples.","spans":[{"start":0,"end":21,"type":"strong"}],"direction":"ltr"},{"type":"o-list-item","text":"Check eligibility and terms: Make sure your credit score aligns with the terms offered. Confirm whether terms are fixed, how fees are calculated, and what happens if payments are missed.","spans":[{"start":0,"end":27,"type":"strong"}],"direction":"ltr"},{"type":"o-list-item","text":"Be honest about habits: A balance transfer keeps debt revolving during the promotional period and only saves money if you avoid new charges and pay the balance before the window ends.","spans":[{"start":0,"end":22,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Taking time to evaluate each factor gives you a clearer picture of affordability and sustainability. Make sure the option you choose supports lasting financial progress before you take action.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"How to Get Started with Credit Card Debt Consolidation","spans":[{"start":0,"end":54,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Once you have chosen the right consolidation option for you, you’re ready to take the next step:","spans":[],"direction":"ltr"},{"type":"o-list-item","text":"Gather your details: List each card’s balance, APR, due date, and account number so you know exactly what you are paying off.","spans":[{"start":0,"end":19,"type":"strong"}],"direction":"ltr"},{"type":"o-list-item","text":"Select a provider: Choose a lender, card issuer, or counseling agency that fits.","spans":[{"start":0,"end":17,"type":"strong"}],"direction":"ltr"},{"type":"o-list-item","text":"Apply and review terms: Submit your application, review all fees and conditions, and accept only if the numbers make sense for your financial plan.","spans":[{"start":0,"end":22,"type":"strong"}],"direction":"ltr"},{"type":"o-list-item","text":"Pay off your balances: Use the loan funds or transfer to clear credit card balances.","spans":[{"start":0,"end":21,"type":"strong"}],"direction":"ltr"},{"type":"o-list-item","text":"Stay on track: Set up autopay to simplify repayment and keep your spending in check to make progress toward your financial goals.","spans":[{"start":0,"end":13,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Once your application is approved and your repayment terms are set, knowing what comes next can help you keep progress steady.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"What to Expect After Consolidating Credit Card Debt","spans":[{"start":0,"end":51,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Consolidation can be a powerful step forward, but progress takes time. Keep these expectations in mind:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Credit score may dip at first: Opening a new account may cause a short-term dip but steady payments help your score improve over time.","spans":[{"start":0,"end":29,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Your spending habits matter: Consolidation works best when paired with mindful spending and steady progress on your new balance.","spans":[{"start":0,"end":29,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Budget is key: Tracking expenses and sticking to a plan is what turns consolidation into real, lasting progress.","spans":[{"start":0,"end":13,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Debt repayment takes time: While consolidation changes the structure of your debt, on-time payments are keys to success.","spans":[{"start":0,"end":25,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"By approaching consolidation with clear expectations, you can use it as a foundation for long-term financial progress rather than a quick fix.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Ready to simplify your debt?","spans":[{"start":0,"end":28,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Apply for a personal loan to consolidate your credit card debt. ","spans":[],"direction":"ltr"},{"type":"list-item","text":"Personal loans between $5,000 - $50,000‡","spans":[],"direction":"ltr"},{"type":"list-item","text":"Rates as low as 7.95% APR‡","spans":[],"direction":"ltr"},{"type":"list-item","text":"Pay it off in 2-5 years**","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Check my rate","spans":[{"start":0,"end":13,"type":"hyperlink","data":{"link_type":"Web","url":"https://go.happymoney.com/create-account","target":"_blank"}}],"direction":"ltr"}],"body":[]}},{"id":"aJEWjRkAAEwAsi3M","uid":"credit-check-in-2025","url":null,"type":"blog","href":"https://point-break.cdn.prismic.io/api/v2/documents/search?ref=aTca7RkAAEIASeXF\u0026q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aJEWjRkAAEwAsi3M%22%29+%5D%5D","tags":["08052025 - update PDF link","Updated New PDF","05182025 - updated images alt text"],"first_publication_date":"2025-08-05T18:03:04+0000","last_publication_date":"2025-08-25T16:28:35+0000","slugs":["the-2025-credit-check-in-by-happy-money"],"linked_documents":[],"lang":"en-us","alternate_languages":[],"data":{"seo_title":"2025 Credit Check-In: Personal Loan \u0026 Debt Trends","seo_description":"Explore personal loan trends and credit card debt statistics in Happy Money's 2025 Credit Check-In report. Learn how Americans manage financial stress.","title":[{"type":"heading1","text":"The 2025 Credit Check-In by Happy Money®","spans":[],"direction":"ltr"}],"category":"money","author":"Happy Money","bg_color":"#FFD28F - Golden Hour","publish_date":"2025-08-12","image":{"dimensions":{"width":2700,"height":1539},"alt":"Financial Education","copyright":null,"url":"https://images.prismic.io/point-break/a7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial+Education+%28Define+it%29.png?auto=format,compress","id":"Y5ttcxIAACkAleND","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"},"Mobile":{"dimensions":{"width":100,"height":100},"alt":"Financial Education","copyright":null,"url":"https://images.prismic.io/point-break/a7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial+Education+%28Define+it%29.png?auto=format,compress\u0026rect=581,0,1539,1539\u0026w=100\u0026h=100","id":"Y5ttcxIAACkAleND","edit":{"x":581,"y":0,"zoom":1,"background":"transparent"}}},"content":[{"type":"paragraph","text":"","spans":[],"direction":"ltr"},{"type":"heading2","text":"Overview: Why This Report Matters","spans":[{"start":0,"end":33,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Across the country, Americans are managing over $1 trillion of credit card debt – and many are also navigating financial stress and emotional strain in light of high-interest debt.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"The Credit Check-In, a new study from Happy Money, uncovers how Americans are feeling about their finances, what actions they're taking to manage debt, and where they may be missing opportunities to lighten the burden of credit card debt and build momentum toward their financial goals. ","spans":[{"start":0,"end":19,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Download the full report →","spans":[{"start":0,"end":26,"type":"hyperlink","data":{"link_type":"Web","url":"https://point-break.cdn.prismic.io/point-break/aKdwAqTt2nPbamHL_HappyMoneyCreditCheckIn2025.pdf","target":"_blank"}}],"direction":"ltr"},{"type":"image","url":"https://images.prismic.io/point-break/aJ312aTt2nPbaU5M_WhitepaperSocialCoverImagev1.jpg?auto=format,compress","alt":"Download the complete report: The 2025 Credit Check-In by Happy Money","copyright":null,"dimensions":{"width":2160,"height":1252},"id":"aJ312aTt2nPbaU5M","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"},"linkTo":{"link_type":"Web","url":"https://point-break.cdn.prismic.io/point-break/aKdwAqTt2nPbamHL_HappyMoneyCreditCheckIn2025.pdf","target":"_blank"}},{"type":"heading2","text":"Executive Summary","spans":[{"start":0,"end":17,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"The 2025 Credit Check-In Report by Happy Money reveals how Americans are navigating rising credit card debt and financial stress. Drawing from a national survey of 2,000 U.S. adults, the report highlights key financial behaviors, identifies missed opportunities in debt management strategies, and explores how tools like personal loans can improve financial outcomes.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Designed for both consumers and the financial institutions that serve them, this report offers a data-backed look at credit behavior trends and practical solutions for the year ahead.","spans":[],"direction":"ltr"},{"type":"heading3","text":"Key Findings: Financial Stress, Debt Behavior \u0026 Consumer Inaction","spans":[{"start":0,"end":65,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"42% of respondents say they are concerned about their credit card payments.","spans":[{"start":0,"end":3,"type":"strong"},{"start":32,"end":41,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"42% of those say that concern has affected their mental health, and 34% say it's impacted their sleep.","spans":[{"start":0,"end":3,"type":"strong"},{"start":49,"end":62,"type":"strong"},{"start":68,"end":71,"type":"strong"},{"start":96,"end":101,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Paying down debt is one of people's top three financial goals; 36% cited it as a top goal.","spans":[{"start":0,"end":16,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Yet, 21% of respondents have taken no steps to manage debt or reduce financial stress in the past six months.","spans":[{"start":0,"end":4,"type":"strong"},{"start":5,"end":8,"type":"strong"},{"start":29,"end":43,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Only 8% have consolidated or refinanced their debt in the past six months.","spans":[{"start":0,"end":7,"type":"strong"},{"start":13,"end":39,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"The findings reveal a clear gap between people's financial goals and the actions they're taking – revealing an opportunity to provide strategic financial tools and guidance to help them make progress.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"This report explores what strategies people are using today and how structured financial solutions like personal loans can help consumers reduce stress and build confidence in their credit journey.","spans":[],"direction":"ltr"},{"type":"heading2","text":"The Mental \u0026 Emotional Cost of Credit Card Stress","spans":[{"start":0,"end":49,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Our survey found that credit card debt is affecting more than just bank accounts and household balance sheets. Of the 42% of respondents who report concern over their credit card payments, nearly half (42%) say this concern has had a direct impact on their mental health, and over a third (34%) say it has disrupted their sleep.","spans":[],"direction":"ltr"},{"type":"image","url":"https://images.prismic.io/point-break/aJEsMaTt2nPbZ1RZ_CCConcerns.png?auto=format,compress","alt":"Impact of credit card debt on mental health and sleep in 2025","copyright":null,"dimensions":{"width":914,"height":456},"id":"aJEsMaTt2nPbZ1RZ","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},{"type":"paragraph","text":"For many people, the impact of credit card debt is not just about the amount they owe. It's about the complexity of juggling multiple balances with different interest rates and payment dates. It can feel overwhelming to figure out the fastest path forward to paying off this debt.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"It's no wonder credit card stress is affecting day-to-day realities like work performance and family dynamics. This reality underscores the need for financial tools that support consumers' efforts to reduce high-interest debt.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\"The Credit Check-In confirms what broader economic data has shown: many Americans are   feeling the strain of a high cost of living and are cutting back, delaying major purchases, and relying on credit to manage expenses.\" — Matt Potere, CEO of Happy Money","spans":[{"start":0,"end":257,"type":"em"}],"direction":"ltr"},{"type":"heading2","text":"The Challenge of Managing Revolving Credit Balances","spans":[{"start":0,"end":51,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Many Americans report carrying a balance month to month – a pattern that can make it harder to pay down debt. Our survey found that 37% of people carry a credit card balance every month, and that number rises to 45% for those aged 35–44 and 44% for those aged 45–54.","spans":[],"direction":"ltr"},{"type":"image","url":"https://images.prismic.io/point-break/aKOFaaTt2nPbab2Z_RevolvingCreditBalances.png?auto=format,compress","alt":"37% of Americans carry a credit card balance every month","copyright":null,"dimensions":{"width":1800,"height":1060},"id":"aKOFaaTt2nPbab2Z","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},{"type":"paragraph","text":"Credit cards can offer cashflow flexibility, convenience, and a way to build credit history. But when balances carry over from month to month, the interest can add up quickly, turning short-term borrowing into a longer-term challenge – especially with average credit card APRs sitting above 20%.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"While many respondents expressed an intention to pay down credit card debt, some are not confident about the best way to achieve that goal. We asked what people’s financial goals are right now, and their top three are:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Covering daily expenses: 42%","spans":[],"direction":"ltr"},{"type":"list-item","text":"Generally building savings: 40%","spans":[],"direction":"ltr"},{"type":"list-item","text":"Paying down debt: 36%","spans":[],"direction":"ltr"},{"type":"image","url":"https://images.prismic.io/point-break/aKOF46Tt2nPbab2f_Top3boxStats.png?auto=format,compress","alt":"Top Financial Goals Right Now table from the Credit Check-in by Happy Money survey: What are your top financial goals right now? Out of total respondents, 42% identified covering daily expenses, 40% choose generally building savings, and 36% selected paying down debt","copyright":null,"dimensions":{"width":2284,"height":1084},"id":"aKOF46Tt2nPbab2f","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},{"type":"heading2","text":"Debt Actions \u0026 Gaps: Why Some Strategies Fall Short","spans":[{"start":0,"end":51,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Even though many Americans feel pressure from credit card debt, just 8% of respondents consolidated or refinanced their debt in the past six months – a potential missed opportunity to save significantly on interest and simplify repayment. See below for an example of how much a personal loan could save compared to chipping away at high-interest credit card payments.","spans":[],"direction":"ltr"},{"type":"image","url":"https://images.prismic.io/point-break/aJE-zqTt2nPbZ1Vw_Screenshot2025-08-04at7.13.59PM.png?auto=format,compress","alt":"Actions taken to manage debt in past 6 months","copyright":null,"dimensions":{"width":1482,"height":702},"id":"aJE-zqTt2nPbZ1Vw","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},{"type":"paragraph","text":"This finding is especially striking: 21% of respondents have taken no action at all to manage debt or reduce financial stress in the past six months – despite the reported mental and emotional stress of concern over credit card payments. Among those who are taking steps, many are relying on short-term tactics like delaying purchases or trimming expenses which don't always address the root issue: high-interest credit card debt.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Moreover, some strategies may help in one area but limit progress elsewhere. For example, 21% report using savings to pay down debt, which works toward their goal of debt reduction but may make it harder to build savings or an emergency fund.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Most notably, few are using tools like debt consolidation or structured repayment plans which can offer fixed payments, lower interest rates, and clear payoff timelines to help people repay debt more confidently and affordably.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\"Creditworthy consumers may be overlooking responsible borrowing opportunities to reduce high-interest debt faster and more affordably – such as through a fixed-rate personal loan.\" — Matt Potere, CEO of Happy Money","spans":[{"start":0,"end":215,"type":"em"}],"direction":"ltr"},{"type":"heading2","text":"Tools to Support Financial Progress","spans":[{"start":0,"end":35,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"A smart financial plan uses the right tools for the job, helping people make meaningful progress toward their goals. Many Americans are taking prudent steps like budgeting and saving, but they might be overlooking additional solutions that can improve their balance sheet health and reduce financial stress.","spans":[],"direction":"ltr"},{"type":"heading3","text":"Budgeting \u0026 Planning","spans":[{"start":0,"end":20,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Building and updating a clear monthly budget is the foundation for smart money decisions. It's important to support your budget with wise financial strategies so you feel confident in sticking to your goals.","spans":[],"direction":"ltr"},{"type":"heading3","text":"Home Equity Lines of Credit (HELOCs)","spans":[{"start":0,"end":36,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"For homeowners with equity, HELOCs can help fund large expenses like education or home improvements. They often offer lower interest rates for major planned expenses but should be used for long-term value, not short-term relief.","spans":[],"direction":"ltr"},{"type":"heading3","text":"Buy Now, Pay Later (BNPL)","spans":[{"start":0,"end":25,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"BNPL has become popular for its payment flexibility but can be difficult to track and may soon impact credit scores. While once seen as an alternative to credit cards, BNPL can create budgeting challenges, especially if repayment schedules overlap.","spans":[],"direction":"ltr"},{"type":"heading3","text":"Negotiating with Creditors","spans":[{"start":0,"end":26,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Many consumers may not know they can contact creditors to discuss lower rates or extended terms. You may also be able to work with creditors directly to settle debts for less than the full amount owed, but be aware that this can negatively impact your credit score.","spans":[],"direction":"ltr"},{"type":"heading3","text":"Personal Loans for Debt Consolidation","spans":[{"start":0,"end":37,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Fixed-rate personal loans can help consumers reduce revolving debt faster, regain control of payments, and lower total interest costs. With fixed payments, lower interest rates, and a defined payoff timeline, personal loans can ease both financial and emotional stress.","spans":[],"direction":"ltr"},{"type":"heading2","text":"How Smart Borrowing Can Support Faster Financial Progress","spans":[{"start":0,"end":57,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Many Americans are trying to cut back, delay expenses, or even dip into savings to stay on top of their financial obligations. Rather than relying solely on these strategies, responsible borrowing may give consumers a faster, clearer path to financial relief without hindering other goals. Specifically, personal loans offer a simplified and transparent way to reduce high-interest credit card debt – with fixed terms, one monthly payment and a clear payoff date.","spans":[],"direction":"ltr"},{"type":"heading3","text":"Consider This Scenario: Credit Card Debt vs. Personal Loan","spans":[{"start":0,"end":58,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Debt consolidation can save you time and money in the long run. For instance, consolidating $20,000 of credit card debt at 24% APR into a personal loan at 16% APR could save over $7,000 in interest and shorten repayment time by nearly a year.","spans":[],"direction":"ltr"},{"type":"image","url":"https://images.prismic.io/point-break/aKdu7aTt2nPbamEv_ScenarioChart-2-.png?auto=format,compress","alt":"A line graph depicting the amount of time (represented in months) it would take a borrower to pay off a personal loan versus a credit card debt. The graph depicts the loan as being paid off in four years, whereas the credit card debt would be paid off in 4.9 years Based on their different interest rates.","copyright":null,"dimensions":{"width":2284,"height":1474},"id":"aKdu7aTt2nPbamEv","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},{"type":"paragraph","text":"Moreover, debt consolidation through a personal loan can help you feel more confident and in control of your finances by having a clear plan: one payment, one interest rate, and one defined payoff date. That should be welcome news given that 21% of respondents said they're not confident in their ability to meet their financial obligations over the next six months. The fixed, predictable monthly payments that personal loans offer can help increase consumer confidence and give back a sense of stability and control.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"*Rates, terms and savings vary based on credit score and other factors. We used NerdWallet's debt consolidation calculator to estimate savings. Key assumptions: a starting balance/loan amount of $20,000; credit card APR of 24% and $580 monthly payment; loan APR of 16% with a 4-year term and $567 monthly payment. Interest saved is over $7,000. Scenario is for example purposes only.","spans":[{"start":80,"end":122,"type":"hyperlink","data":{"link_type":"Web","url":"https://www.nerdwallet.com/article/loans/personal-loans/debt-consolidation-calculator","target":"_blank"}}],"direction":"ltr"},{"type":"heading2","text":"How Financial Institutions Can Close the Gap","spans":[{"start":0,"end":44,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Trusted financial institutions have an opportunity to support consumer well-being by providing guidance and responsible credit solutions designed to help people manage debt and reduce stress. By offering well-structured personal loans, credit unions and banks can:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Support their members' top financial goals","spans":[],"direction":"ltr"},{"type":"list-item","text":"Build trust and long-term loyalty","spans":[],"direction":"ltr"},{"type":"list-item","text":"Diversify their portfolios with high-quality, short-duration assets","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Smart, transparent personal loans are a win-win for institutions and the people they serve – helping Americans reduce debt and financial stress while optimizing portfolio performance.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\"Financial institutions that offer responsible credit solutions such as personal loans are well positioned to attract new customers and strengthen existing relationships.\" — Matt Potere, CEO, Happy Money","spans":[{"start":0,"end":203,"type":"em"}],"direction":"ltr"},{"type":"paragraph","text":"With the right partner, financial institutions can originate high-quality loans, diversify their balance sheets, and grow responsibly by offering financial solutions that are:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Transparent and easy to understand","spans":[],"direction":"ltr"},{"type":"list-item","text":"Structured for predictability","spans":[],"direction":"ltr"},{"type":"list-item","text":"Designed to reduce financial stress","spans":[],"direction":"ltr"},{"type":"heading3","text":"Takeaway for Lending Leaders","spans":[{"start":0,"end":28,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"A well-structured personal loan can reduce portfolio risk, increase member loyalty, and unlock long-term growth – especially when it's delivered through a trusted partner.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Learn about partnering with Happy Money →","spans":[{"start":0,"end":41,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/lending-partners","target":"_blank"}}],"direction":"ltr"},{"type":"heading2","text":"Looking for a Smarter Way to Pay Down Credit Card Debt?","spans":[{"start":0,"end":55,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Happy Money helps you consolidate high-interest credit card debt through a fixed-rate personal loan – so you can simplify payments, reduce financial stress, and make progress toward your goals.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Lower interest rates than most credit cards ","spans":[],"direction":"ltr"},{"type":"list-item","text":"One fixed monthly payment and a clear payoff date ","spans":[],"direction":"ltr"},{"type":"list-item","text":"Designed to support you and your financial goals","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Check your rate with no impact to your credit →","spans":[{"start":0,"end":47,"type":"hyperlink","data":{"link_type":"Web","url":"https://www.happymoney.com/","target":"_blank"}}],"direction":"ltr"},{"type":"heading2","text":"About Happy Money","spans":[{"start":0,"end":17,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Happy Money is a consumer finance company that empowers people to achieve their goals through responsible lending. Our loans are built with transparency and ease in mind, giving you more time to do what you love. We save you money with low interest rates and a simple monthly payment schedule. By partnering with credit unions and other trusted financial institutions, we prioritize members’ best interests and work together to offer personal loans with lower rates, no hidden fees, and a clear path to payoff. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Together with our capital partner network, Happy Money has originated over $6 billion in loans representing more than 300,000 people who have taken greater control of their financial futures. Learn more at happymoney.com. ","spans":[{"start":206,"end":220,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com","target":"_blank"}}],"direction":"ltr"},{"type":"image","url":"https://images.prismic.io/point-break/aKOHAqTt2nPbab2o_Partnernetworkstatsv3.png?auto=format,compress","alt":"Over 300K people have taken control of their finances with a Happy Money loan","copyright":null,"dimensions":{"width":2284,"height":1274},"id":"aKOHAqTt2nPbab2o","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},{"type":"heading2","text":"About The Report: 2025 Credit Check-In Methodology","spans":[{"start":0,"end":50,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"The 2025 Credit Check-In Report is part of Happy Money's broader effort to bring timely, actionable insights to consumers and financial partners.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"This online survey of 2,000 US adults (nationally representative on age, gender and region) was commissioned by Happy Money and conducted by market research company OnePoll, in accordance with the Market Research Society's code of conduct. Data was collected between June 26 and July 9, 2025. All participants are double-opted in to take part in research and are paid an amount depending on the length and complexity of the survey. This survey was overseen and edited by the OnePoll research team. OnePoll are MRS Company Partners, corporate membership of ESOMAR and Members of the British Polling Council.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Download the full report →","spans":[{"start":0,"end":26,"type":"hyperlink","data":{"link_type":"Web","url":"https://point-break.cdn.prismic.io/point-break/aKdwAqTt2nPbamHL_HappyMoneyCreditCheckIn2025.pdf","target":"_blank"}}],"direction":"ltr"},{"type":"heading2","text":"Frequently Asked Questions (FAQ)","spans":[{"start":0,"end":32,"type":"strong"}],"direction":"ltr"},{"type":"heading3","text":"What is the 2025 Credit Check-In Report by Happy Money?","spans":[{"start":0,"end":55,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"The 2025 Credit Check-In is a national study commissioned by Happy Money to explore how Americans are managing credit card debt and financial stress. The report shares key findings from a representative survey of 2,000 U.S. adults and offers insights into debt behavior, personal loan trends, and opportunities for financial institutions to better support consumers' goals.","spans":[],"direction":"ltr"},{"type":"heading3","text":"How are Americans managing credit card debt in 2025?","spans":[{"start":0,"end":52,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"According to the 2025 Credit Check-In, many Americans are struggling with credit card debt. While 42% are concerned about their payments, only 8% have used tools like debt consolidation or personal loans to manage it more effectively.","spans":[],"direction":"ltr"},{"type":"heading3","text":"What is the mental and emotional impact of credit card debt?","spans":[{"start":0,"end":60,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"The report found that 42% of those worried about their credit card payments say the stress has affected their mental health, and 34% say it has disrupted their sleep – underscoring the emotional toll of revolving credit.","spans":[],"direction":"ltr"},{"type":"heading3","text":"What actions are people taking to reduce financial stress?","spans":[{"start":0,"end":58,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Most consumers are relying on short-term strategies like delaying purchases or using savings. Only a small percentage have taken strategic actions like refinancing or consolidating debt, according to Happy Money's 2025 Credit Check-In.","spans":[],"direction":"ltr"},{"type":"heading3","text":"Why are personal loans a smart option for debt consolidation?","spans":[{"start":0,"end":61,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Fixed-rate personal loans can reduce total interest paid, offer predictable monthly payments, and help borrowers pay off credit card debt faster – making them a smarter solution for many consumers.","spans":[],"direction":"ltr"},{"type":"heading3","text":"How do personal loans compare to credit card payments?","spans":[{"start":0,"end":54,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"The report outlines a scenario where consolidating $20,000 of credit card debt at 24% APR into a personal loan at 16% APR could save over $7,000 in interest and shorten repayment time by nearly a year.","spans":[],"direction":"ltr"},{"type":"heading3","text":"What are the top financial goals for Americans right now?","spans":[{"start":0,"end":57,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"The top three goals identified in the report are:","spans":[],"direction":"ltr"},{"type":"o-list-item","text":"Covering daily expenses","spans":[],"direction":"ltr"},{"type":"o-list-item","text":"Building savings","spans":[],"direction":"ltr"},{"type":"o-list-item","text":"Paying down debt","spans":[],"direction":"ltr"},{"type":"heading3","text":"How can financial institutions support consumers more effectively?","spans":[{"start":0,"end":66,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"The report suggests that financial institutions like credit unions and banks can close the gap and help consumers pursue their goals with greater confidence by offering responsible personal loan products that address both the financial and emotional burdens of debt.","spans":[],"direction":"ltr"},{"type":"heading3","text":"What is Happy Money's role in helping reduce credit card debt?","spans":[{"start":0,"end":62,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Happy Money offers fixed-rate personal loans that help consumers consolidate high-interest credit card balances, simplify payments, and make meaningful progress toward their financial goals.","spans":[],"direction":"ltr"},{"type":"heading3","text":"Where can I download the full 2025 Credit Check-In Report?","spans":[{"start":0,"end":58,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"You can download the full report here.","spans":[{"start":33,"end":38,"type":"hyperlink","data":{"link_type":"Web","url":"https://point-break.cdn.prismic.io/point-break/aKdwAqTt2nPbamHL_HappyMoneyCreditCheckIn2025.pdf","target":"_blank"}}],"direction":"ltr"},{"type":"paragraph","text":"","spans":[],"direction":"ltr"},{"type":"paragraph","text":"","spans":[],"direction":"ltr"}],"body":[]}},{"id":"Y5uGexIAACkAllLG","uid":"what-is-the-30-day-rule-for-personal-finance","url":null,"type":"blog","href":"https://point-break.cdn.prismic.io/api/v2/documents/search?ref=aTca7RkAAEIASeXF\u0026q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22Y5uGexIAACkAllLG%22%29+%5D%5D","tags":[],"first_publication_date":"2022-12-16T17:05:18+0000","last_publication_date":"2025-08-07T13:32:14+0000","slugs":["what-is-the-30-day-rule-for-personal-finance"],"linked_documents":[],"lang":"en-us","alternate_languages":[],"data":{"seo_title":"The 30-Day Rule: Avoid Impulse Buys | Happy Money","seo_description":"The 30 day rule asks you to pause for one month before making an impulse purchase. Learn how the 30 day rule can give your savings a boost.","title":[{"type":"heading1","text":"What Is the 30 Day Rule for Personal Finance?","spans":[]}],"category":null,"author":"Happy Money","bg_color":"#FBC6ED - Bubble Gum Pop","publish_date":"2025-05-03","image":{"dimensions":{"width":2700,"height":1539},"alt":"Financial Education","copyright":null,"url":"https://images.prismic.io/point-break/a7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial+Education+%28Define+it%29.png?auto=compress,format","id":"Y5ttcxIAACkAleND","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"},"Mobile":{"dimensions":{"width":100,"height":100},"alt":null,"copyright":null,"url":"https://images.prismic.io/point-break/a7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial+Education+%28Define+it%29.png?auto=compress,format\u0026rect=585,0,1539,1539\u0026w=100\u0026h=100","id":"Y5ttcxIAACkAleND","edit":{"x":-38,"y":0,"zoom":0.0649772579597141,"background":"transparent"}}},"content":[{"type":"paragraph","text":"It can feel like a struggle to save money. Sometimes, getting creative with your strategies can help. If you’ve ever heard of the 30 day rule, you might be wondering just how it works. What is the 30 day rule, and how can you use it to your advantage?","spans":[]},{"type":"heading2","text":"What Is the 30 Day Savings Rule?","spans":[]},{"type":"paragraph","text":"The 30 day rule is pretty simple. Here’s how it works. Any time you are about to make a non-essential purchase, you instead pause for 30 days. ","spans":[]},{"type":"paragraph","text":"After the 30 day wait, you can reassess. Do you still want the item or service you were going to purchase? If so, you can buy it guilt-free, knowing that you took the time to think it through. If you no longer want or need to make the purchase, you can simply save that money instead — or use it for something that does align more with your current wants and needs. ","spans":[]},{"type":"heading3","text":"Example of the 30 Day Savings Rule","spans":[]},{"type":"paragraph","text":"You head out for some back-to-school shopping for your children. You pick out all the essentials — new clothes, school supplies, and whatever else was on your list. And you spot a new pair of earbuds that would be perfect for your workouts. The problem is, new earbuds weren’t on your list. So, you’re looking at an unplanned purchase of a new item for yourself.","spans":[]},{"type":"paragraph","text":"With the 30-day rule in mind, you can mindfully pause. You can move forward with the planned purchases for your children and put the optional purchase on the back burner. ","spans":[]},{"type":"paragraph","text":"30 days later, if you still want the earbuds, you can return to the store to buy them. You could even set a reminder on your phone to check in after a month. ","spans":[]},{"type":"heading2","text":"Why Does the 30 Day Rule Work?","spans":[]},{"type":"paragraph","text":"The 30 day rule enables you to spend with more intention. By inserting a pause into your optional spending decisions, you can take time to think about what you really want. ","spans":[]},{"type":"paragraph","text":"It’s also a way to remove guilt from purchases. We all make unplanned purchases — and that’s totally okay. But if you find yourself feeling guilty after buying something, the 30 day rule might be a good option for you.","spans":[]},{"type":"paragraph","text":"After all, if we can have the self-control to wait 30 days before buying something, and we still want it after that wait, then we can fully enjoy that purchase without guilt. ","spans":[]},{"type":"heading2","text":"How to Maximize Your Money Using the 30 Day Rule","spans":[]},{"type":"paragraph","text":"The 30 day rule can help you improve your spending habits, which can result in more intentional purchases, more money saved, and less financial stress. But it’s not all about saving money. It’s really about being intentional, and thinking through your spending decisions. Here’s how to maximize your success with the 30 day rule. ","spans":[{"start":134,"end":150,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/what-is-financial-stress"}}]},{"type":"heading3","text":"Know When — and Where — to Save","spans":[]},{"type":"paragraph","text":"The 30 day rule can be a powerful boost to help you save more money. After pausing for 30 days, you’ll have had time to think about whether you truly want or need that purchase. And in many cases, the answer will be no.","spans":[]},{"type":"paragraph","text":"If you decide not to make the purchase, what should you actually do with the money? Well, you have several options:","spans":[]},{"type":"list-item","text":"Use it to pay down debt or invest (see below)","spans":[{"start":10,"end":23,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/payoff-loan"}}]},{"type":"list-item","text":"Keep it in your checking account","spans":[]},{"type":"list-item","text":"Transfer it to a savings account","spans":[]},{"type":"list-item","text":"Open a high-yield savings account to earn more interest","spans":[]},{"type":"paragraph","text":"You could choose to make small transfers to your savings every time you decide not to make a purchase. Or, you could transfer once a month based on your spending habits for the previous month. ","spans":[]},{"type":"heading3","text":"Consider Investing or Paying Down Debt","spans":[]},{"type":"paragraph","text":"For an even bigger boost to your personal finances, consider using your new savings to invest or pay down debt. ","spans":[]},{"type":"paragraph","text":"Paying off debt should generally be your top priority, particularly if it’s high-interest debt. This can help you save money on interest, lower your total debt, and even improve your credit score. ","spans":[{"start":0,"end":15,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/how-to-pay-off-debt-quickly"}},{"start":76,"end":94,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/how-to-pay-off-high-interest-debt-guide"}}]},{"type":"paragraph","text":"Investing for the future should also be a top financial goal. You can start a brokerage account to buy stocks, or contribute money to your workplace retirement account. ","spans":[]},{"type":"heading3","text":"Enjoy Your Purchases Guilt-Free","spans":[]},{"type":"paragraph","text":"Remember, money can’t buy happiness — so if you truly do want that purchase, and it might bring you joy or satisfaction, be sure to enjoy it guilt-free.","spans":[{"start":10,"end":35,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/can-money-buy-happiness-we-surveyed-2000-people"}},{"start":54,"end":56,"type":"em"}]},{"type":"paragraph","text":"The 30 day rule isn’t about being a stickler and never spending money. It’s just about pausing to intentionally think about your purchases before making them. If after a month of waiting you still want the item or service, go ahead and buy it — and enjoy. ","spans":[]},{"type":"heading3","text":"Split the Difference","spans":[]},{"type":"paragraph","text":"Spending decisions don’t have to be all-or-nothing. You can also choose to split the difference, so to speak. ","spans":[]},{"type":"paragraph","text":"For instance, let’s say you are thinking about buying a new patio furniture set, but you decide to use the 30 day rule to wait it out. After 30 days, you decide that you really do want some outdoor furniture — but you realize that you really only need a few chairs to enjoy your porch. Instead of opting for the expensive set, you can choose to purchase some inexpensive chairs — and save the rest of the money for a rainy day. ","spans":[]},{"type":"paragraph","text":"If you’re on the fence, you can simply keep the money in a sinking fund. You can later use the money to make the purchase, or repurpose it for one of your other financial goals (like paying off debt or saving for retirement).","spans":[]},{"type":"heading2","text":"See What the 30 Day Savings Rule can do for You","spans":[]},{"type":"paragraph","text":"The 30 day rule is a unique approach to spending decisions that can encourage more intentional spending. It can help you develop a savings mindset, while also enjoying the purchases you do make with less guilt. Give it a try and see how it works for you. ","spans":[{"start":121,"end":146,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/get-into-a-savings-mindset-with-ease"}}]}],"body":[]}},{"id":"Y5uIKBIAACkAllpT","uid":"what-makes-up-your-credit-score","url":null,"type":"blog","href":"https://point-break.cdn.prismic.io/api/v2/documents/search?ref=aTca7RkAAEIASeXF\u0026q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22Y5uIKBIAACkAllpT%22%29+%5D%5D","tags":[],"first_publication_date":"2022-12-16T17:05:17+0000","last_publication_date":"2025-09-11T14:11:16+0000","slugs":["what-makes-up-your-credit-score"],"linked_documents":[],"lang":"en-us","alternate_languages":[],"data":{"seo_title":"What Makes Up Your Credit Score? | Happy Money","seo_description":"Credit scores are based on your payment history, amounts owed, length of credit history, new credit, and credit mix. Learn more here.","title":[{"type":"heading1","text":"What Makes Up Your Credit Score?","spans":[]}],"category":null,"author":"Happy Money","bg_color":"#FFC4B3 - Coral Sorbet","publish_date":"2025-04-04","image":{"dimensions":{"width":2700,"height":1539},"alt":"Makes Up Your Credit Score","copyright":null,"url":"https://images.prismic.io/point-break/a7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial+Education+%28Define+it%29.png?auto=compress,format","id":"Y5ttcxIAACkAleND","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"},"Mobile":{"dimensions":{"width":100,"height":100},"alt":null,"copyright":null,"url":"https://images.prismic.io/point-break/a7837951-8090-4a06-95bd-1f3d1d3e7d89_Financial+Education+%28Define+it%29.png?auto=compress,format\u0026rect=585,0,1539,1539\u0026w=100\u0026h=100","id":"Y5ttcxIAACkAleND","edit":{"x":-38,"y":0,"zoom":0.0649772579597141,"background":"transparent"}}},"content":[{"type":"paragraph","text":"Your credit score can influence many aspects of your personal finances. A good score can make it easier to get approved for loans, rent apartments, and secure better interest rates. A bad score can hold you back in your personal finance journey, making everything more difficult — and more expensive. Credit scores are complex, though and understanding how credit scores work is often the first step toward improving your own score. ","spans":[],"direction":"ltr"},{"type":"heading2","text":"What Is a Credit Score? ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"A credit score is a numerical score that measures your creditworthiness, or your estimated ability to pay back loans. It’s based on your credit history, which includes how you’ve handled debts and payments in the past. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"A good score tells lenders that you are likely to be able to repay your debts. It means less risk for the lender, which makes them more willing to lend.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"A lower score tells lenders that you are riskier and that you might not be able to repay your debts. This can make lenders more hesitant to lend you money — and often means that you’ll pay higher interest rates if you are approved. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"There are a few different credit scoring models, but the most common is the FICOⓇ credit score. The FICO model is used by around 90% of U.S. financial institutions. ","spans":[{"start":129,"end":132,"type":"hyperlink","data":{"link_type":"Web","url":"https://www.fico.com/en/products/fico-score","target":"_blank"}}],"direction":"ltr"},{"type":"paragraph","text":"FICO credit scores range from 300 to 850, with 850 being the best possible score. Scores can be lumped into the following score ranges:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Poor credit: 300 to 579","spans":[{"start":0,"end":13,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Fair credit: 580 to 669","spans":[{"start":0,"end":13,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Good credit: 670 to 739","spans":[{"start":0,"end":13,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Very good credit: 740 to 799","spans":[{"start":0,"end":18,"type":"strong"}],"direction":"ltr"},{"type":"list-item","text":"Exceptional credit: 800 to 850","spans":[{"start":0,"end":20,"type":"strong"}],"direction":"ltr"},{"type":"heading2","text":"What Makes Up Your Credit Score? ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Your credit score is made up of data in your credit report. Lenders report information about your credit usage to the credit bureaus, which use this data to compile your credit report and calculate your score. This data includes information on how you’ve handled credit cards, loans, mortgages, and other forms of credit. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"There are five broad categories that go into your credit score:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Payment history - 35% of your credit score","spans":[],"direction":"ltr"},{"type":"list-item","text":"Amounts owed - 30% of your credit score","spans":[],"direction":"ltr"},{"type":"list-item","text":"Credit history length - 15% of your credit score","spans":[],"direction":"ltr"},{"type":"list-item","text":"New credit - 10% of your credit score","spans":[],"direction":"ltr"},{"type":"list-item","text":"Credit mix - 10% of your credit score","spans":[],"direction":"ltr"},{"type":"heading3","text":"Payment History","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Payment history is a record of all the payments you’ve made toward your debts. It’s the most important credit scoring factor, making up 35% of your total credit score. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Each time a payment is made, the lender reports that data to the credit bureaus. Each on-time payment will improve your payment history and slightly boost your score. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Late payments, missed payments, or delinquent accounts will damage your score. Even a single late payment can ding your score significantly. Consistency is vital when it comes to improving your score over time with your payment history.","spans":[],"direction":"ltr"},{"type":"heading3","text":"How to improve payment history","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Simply keep making on-time payments on all your accounts, and this factor will improve over time. To avoid accidental late payments, it’s a good idea to set up autopay on all your accounts. ","spans":[],"direction":"ltr"},{"type":"heading3","text":"Amounts Owed","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Amounts owed refers to the amount of money you have borrowed and currently owe. It’s another very important factor, making up 30% of your credit score. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"From a credit rating perspective, owing money isn’t necessarily a bad thing — it’s more about how much you owe, compared to how much is available for you to borrow. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Lenders primarily look at factors like your credit utilization ratio, which is the percentage of your available credit that you are using. For example, if you have a total credit limit of $10,000, and you have a total debt balance of $4,000, you are using 40% of your available credit ($4,000/$10,000). This means your credit utilization ratio is at 40%. ","spans":[{"start":44,"end":68,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"If you are using the majority of your available credit, lenders might view you as a higher risk to default on your debts. A lower credit utilization ratio signals to lenders that you are responsibly using your available credit lines, and are a lower risk. ","spans":[],"direction":"ltr"},{"type":"heading3","text":"How to improve amounts owed","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Aim to keep your credit utilization ratio under 30%. In other words, try to use less than 30% of your available credit at any given time. This applies to per-card utilization as well as total utilization. Try not to use any more than 30% of your credit limit on any credit card, while also keeping your total balances under 30% of your combined credit limit. ","spans":[{"start":154,"end":174,"type":"strong"},{"start":186,"end":203,"type":"strong"}],"direction":"ltr"},{"type":"heading3","text":"Credit History Length","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Credit history length refers to how long you have been actively using credit and making payments. It makes up 15% of your credit score. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"The primary way credit history length is measured is by looking at your average age of accounts. This looks at every account and finds the average age of those accounts.","spans":[{"start":72,"end":95,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"It doesn’t matter if you actually use the accounts — as long as they are open and in good standing, they will contribute to your average age of accounts. However, keep in mind that some lenders will close inactive accounts after a certain period of time. To keep unused accounts open, it’s a good idea to use them for a small purchase once per year or so.","spans":[],"direction":"ltr"},{"type":"heading3","text":"How to improve credit history length","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Keep your old accounts open, even if you don’t actively use them. New accounts will also lower your average age, so only open new credit accounts when it’s necessary. ","spans":[],"direction":"ltr"},{"type":"heading3","text":"New Credit","spans":[],"direction":"ltr"},{"type":"paragraph","text":"New credit refers to recently opened credit accounts. It makes up 10% of your credit score. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"New accounts are not necessarily a bad thing when it comes to your credit score — but too many recently opened accounts can signal to lenders that you might be a risky borrower. This factor also looks at recent credit inquiries on your file. An inquiry occurs when you apply for a loan or credit card.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Credit inquiries can either be “soft” or “hard”. A soft pull does not affect your credit, but a hard pull does. When applying for new credit, the lender will typically conduct a hard pull, while soft pulls are typically used when checking if you’re preapproved for a loan. ","spans":[],"direction":"ltr"},{"type":"heading3","text":"How to improve new credit","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Only open new credit accounts when it’s necessary. You may also wish to consider spreading out new applications over a period of time. The exception to this rule is if you are applying for a mortgage and you’re hoping to shop around for rates. In this case, hard pulls made within a 14-day period are considered as only one inquiry. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"However, the inquiries must be for the same type of credit. If you check rates from three different mortgage providers in a 14-day period, those inquiries will have no more impact than a single hard inquiry. But if you apply for a mortgage, credit card, and personal loan in the same window, each inquiry will be considered separate and will affect your score. ","spans":[{"start":44,"end":48,"type":"em"}],"direction":"ltr"},{"type":"heading3","text":"Credit Mix ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Credit mix refers to the variety of credit accounts that you have open. It makes up 10% of your credit score. ","spans":[{"start":0,"end":10,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/types-of-debt-how-credit-mix-affects-your-credit-score","target":"_blank"}}],"direction":"ltr"},{"type":"paragraph","text":"Lenders prefer to see borrowers who have a proven track record of responsibly using multiple forms of debt. The different types of accounts that are reported to the credit bureaus include examples such as:","spans":[],"direction":"ltr"},{"type":"list-item","text":"Credit cards","spans":[],"direction":"ltr"},{"type":"list-item","text":"Personal loans","spans":[],"direction":"ltr"},{"type":"list-item","text":"Student loans","spans":[],"direction":"ltr"},{"type":"list-item","text":"Mortgages","spans":[],"direction":"ltr"},{"type":"list-item","text":"Auto loans","spans":[],"direction":"ltr"},{"type":"list-item","text":"Lines of credit","spans":[],"direction":"ltr"},{"type":"heading3","text":"How to improve credit mix","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Using a variety of credit types can improve this factor. However, it’s best to only open a new account if you actually need it. Remember, this factor only makes up 10% of your credit score. ","spans":[{"start":8,"end":31,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/types-of-debt-how-credit-mix-affects-your-credit-score","target":"_blank"}}],"direction":"ltr"},{"type":"heading2","text":"Why It’s Important to Understand Credit Score Factors","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Understanding what makes up your credit score can help you take active steps toward improving your own credit. With this knowledge in mind, you can make an informed decision on how to boost your score. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"For instance, if you have too much debt, your “amounts owed” factor may be hurting your score. In this case, paying down debt should be your top priority. Paying off your revolving balances, paying on time, and paying more than the minimum are all great habits to help improve your credit score over time. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"The PayOff Loan™ from Happy Money makes it simpler to pay off credit card debt using a lower-interest personal loan. It can help you consolidate your debt into a single monthly payment, save money on interest, and potentially boost your credit score.  ","spans":[{"start":0,"end":16,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/payoff-loan","target":"_blank"}}],"direction":"ltr"}],"body":[]}},{"id":"Y5ttnBIAACsAleOy","uid":"what-is-an-unsecured-vs-secured-personal-loan","url":null,"type":"blog","href":"https://point-break.cdn.prismic.io/api/v2/documents/search?ref=aTca7RkAAEIASeXF\u0026q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22Y5ttnBIAACsAleOy%22%29+%5D%5D","tags":[],"first_publication_date":"2022-12-16T17:05:20+0000","last_publication_date":"2025-08-18T13:50:54+0000","slugs":["what-is-an-unsecured-vs.-secured-personal-loan"],"linked_documents":[],"lang":"en-us","alternate_languages":[],"data":{"seo_title":"Unsecured vs. Secured Personal Loan","seo_description":"Personal loans can be “secured” or “unsecured”. But what do these terms mean, and which is a better option for you? Learn more here.","title":[{"type":"heading1","text":"What Is an Unsecured vs. Secured Personal Loan?","spans":[]}],"category":null,"author":"Happy Money","bg_color":"#FFD28F - Golden Hour","publish_date":"2025-02-12","image":{"dimensions":{"width":2701,"height":1539},"alt":"Unsecured vs. Secured Personal Loan","copyright":null,"url":"https://images.prismic.io/point-break/Z_OBYndAxsiBwYT4_Financial%2BEducation%2B-Define%2Bit-.webp?auto=format,compress","id":"Z_OBYndAxsiBwYT4","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"},"Mobile":{"dimensions":{"width":100,"height":100},"alt":null,"copyright":null,"url":"https://images.prismic.io/point-break/Z_OBYndAxsiBwYT4_Financial%2BEducation%2B-Define%2Bit-.webp?auto=format,compress\u0026rect=581,0,1539,1539\u0026w=100\u0026h=100","id":"Z_OBYndAxsiBwYT4","edit":{"x":581,"y":0,"zoom":1,"background":"transparent"}}},"content":[{"type":"paragraph","text":"Personal loans are versatile loan products that can be used for a variety of reasons, from funding a major purchase to paying down high-interest debt. There are a few different types of personal loans, with two broad categories to consider: Unsecured personal loans and secured personal loans. But what do these terms really mean, and which might be the best fit for your needs? ","spans":[{"start":241,"end":250,"type":"strong"},{"start":270,"end":277,"type":"strong"}]},{"type":"paragraph","text":"What Is a Personal Loan?","spans":[{"start":0,"end":24,"type":"strong"}]},{"type":"paragraph","text":"A personal loan is a type of installment loan that can be used for any purpose. With a personal loan, you borrow a fixed amount of money upfront, then pay it off over time with consistent monthly payments. ","spans":[]},{"type":"paragraph","text":"What you use the loan for is your own choice. You might use it for a home renovation, a major purchase, or even to pay off other types of debt. ","spans":[]},{"type":"paragraph","text":"Certain types of personal loans may be designed for specific purposes. For instance, many personal loans are offered as a way to pay off high-interest debt. Others are general purpose loans and can be used for anything. ","spans":[{"start":129,"end":155,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/how-to-pay-off-high-interest-debt-guide"}}]},{"type":"paragraph","text":"To get a personal loan, you must apply for one through a bank or lender. The lender will access your credit report to determine your creditworthiness. They use this data to decide if they’re willing to lend you money — and if so, what interest rate they will charge you. ","spans":[]},{"type":"paragraph","text":"Another factor that influences interest rates is whether or not the loan is secured or unsecured. Most are unsecured, but some lenders offer secured loans — potentially at lower interest rates. ","spans":[]},{"type":"heading2","text":"What Is a Secured Personal Loan?","spans":[]},{"type":"paragraph","text":"A secured personal loan is a loan that is backed by an asset that you own. You provide collateral — like a vehicle or an investment account (including any eligible stocks, bonds, exchange-traded funds (ETFs), or mutual funds that you may have in your portfolio) — when you get the loan. If you are unable to repay the loan, the lender can legally take possession of the collateral that you used. ","spans":[]},{"type":"paragraph","text":"Secured personal loans are not very common. However, some lenders offer them as a way to reduce the risk of lending money — and to be able to offer loans at lower interest rates. ","spans":[]},{"type":"heading3","text":"Advantages to Secured Personal Loans","spans":[]},{"type":"list-item","text":"May be offered at a lower interest rate compared to unsecured loans","spans":[]},{"type":"list-item","text":"Generally easier to get approved for","spans":[]},{"type":"heading3","text":"Disadvantages to Secured Personal Loans","spans":[]},{"type":"list-item","text":"Requires ownership of a substantial asset (vehicle, investments, real estate, etc.)","spans":[]},{"type":"list-item","text":"If you default on the loan, the lender can take possession of the collateral you used","spans":[]},{"type":"heading2","text":"What Is an Unsecured Personal Loan? ","spans":[]},{"type":"paragraph","text":"An unsecured personal loan is a standard personal loan that is not “secured” by any asset. ","spans":[]},{"type":"paragraph","text":"When you apply for an unsecured loan, your approval odds are based only on your credit history. The lender will access your credit report and determine how likely you are to be able to repay the loan, based on your credit history. ","spans":[]},{"type":"paragraph","text":"If you end up being unable to repay an unsecured loan, the lender can send your debt to collections, assess penalty fees, and more — but they can’t seize control of your assets. ","spans":[]},{"type":"heading3","text":"Advantages to Unsecured Personal Loans","spans":[]},{"type":"list-item","text":"Doesn’t require collateral","spans":[]},{"type":"list-item","text":"No risk of losing an asset if you can’t repay the loan","spans":[]},{"type":"list-item","text":"Widely available from a variety of banks and lenders  ","spans":[]},{"type":"heading3","text":"Disadvantages to Unsecured Personal Loans","spans":[]},{"type":"list-item","text":"Harder to get approved for (requires a higher credit rating)","spans":[]},{"type":"list-item","text":"Interest rates may be higher","spans":[]},{"type":"heading2","text":"Unsecured vs. Secured Personal Loans Compared","spans":[]},{"type":"paragraph","text":"If you’re trying to decide between a secured and an unsecured loan, it’s wise to first consider these factors: ","spans":[]},{"type":"paragraph","text":"Availability: In general, unsecured loans are more widely available from standard banks, credit unions, and online lenders. Secured loans are less common.","spans":[{"start":0,"end":14,"type":"strong"}]},{"type":"paragraph","text":"Collateral requirements: A secured loan requires that you have a valuable asset to put up as collateral. This could be a vehicle, equity in your home, or the value of your investment accounts. Unsecured loans do not require any sort of collateral. ","spans":[{"start":0,"end":25,"type":"strong"}]},{"type":"paragraph","text":"Interest rates: Generally speaking, interest rates on secured loans will be lower than unsecured loans. This is because secured loans are less risky for the lender, so they are often willing to loan money at a lower interest rate. ","spans":[{"start":0,"end":16,"type":"strong"}]},{"type":"paragraph","text":"Risk: To the borrower, the risk of a secured loan can be considered higher than with an unsecured loan. If you fail to repay a secured loan, you can damage your credit and lose the asset you put up as collateral. If you fail to repay an unsecured loan, your credit will be damaged — but you won’t lose your assets. ","spans":[{"start":0,"end":6,"type":"strong"},{"start":168,"end":171,"type":"em"}]},{"type":"paragraph","text":"Ultimately, there’s no clear “best” type of personal loan. It all depends on your specific needs, credit rating, and other factors. ","spans":[]},{"type":"paragraph","text":"In any case, it pays to shop around. If you have good credit, it’s a good idea to check to see if you can prequalify for an unsecured personal loan, which will allow you to see your estimated interest rate and monthly payments without affecting your credit. ","spans":[]},{"type":"heading2","text":"A Loan to Help You Reclaim Control of Your Finances","spans":[]},{"type":"paragraph","text":"Secured loans are backed by an asset you own, while unsecured loans are solely based on your personal credit. The majority of personal loans are unsecured. ","spans":[]},{"type":"paragraph","text":"If you’re taking out a personal loan to pay off credit card debt, consider The PayOff Loan™ from Happy Money. ","spans":[{"start":75,"end":91,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/payoff-loan"}}]},{"type":"paragraph","text":"The PayOff Loan is an unsecured personal loan that’s designed to help borrowers consolidate high-interest credit card debt into a lower-interest personal loan. It can help qualified borrowers save money on interest, simplify monthly payments, and boost their credit score.","spans":[]},{"type":"paragraph","text":"For more insights on personal finance, credit, and debt, check out the Happy Money blog.  ","spans":[{"start":71,"end":87,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles"}}]}],"body":[]}},{"id":"Y5uMTBIAAC8Alm0K","uid":"types-of-debt-how-credit-mix-affects-your-credit-score","url":null,"type":"blog","href":"https://point-break.cdn.prismic.io/api/v2/documents/search?ref=aTca7RkAAEIASeXF\u0026q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22Y5uMTBIAAC8Alm0K%22%29+%5D%5D","tags":[],"first_publication_date":"2022-12-16T17:05:18+0000","last_publication_date":"2025-08-18T13:50:45+0000","slugs":["types-of-debt-how-credit-mix-affects-your-credit-score"],"linked_documents":[],"lang":"en-us","alternate_languages":[],"data":{"seo_title":"How Credit Mix Affects Your Credit Score","seo_description":"Credit mix is a factor that contributes to your credit score. It measures the different types of debt you have, such as revolving credit or installment loans.","title":[{"type":"heading1","text":"Types of Debt: How Credit Mix Affects Your Credit Score","spans":[]}],"category":null,"author":"Happy Money","bg_color":"#FFF5A7 - Citrine Glow","publish_date":"2025-01-18","image":{"dimensions":{"width":2701,"height":1539},"alt":"How Credit Mix Affects Your Credit Score","copyright":null,"url":"https://images.prismic.io/point-break/Z_OBYndAxsiBwYT4_Financial%2BEducation%2B-Define%2Bit-.webp?auto=format,compress","id":"Z_OBYndAxsiBwYT4","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"},"Mobile":{"dimensions":{"width":100,"height":100},"alt":null,"copyright":null,"url":"https://images.prismic.io/point-break/Z_OBYndAxsiBwYT4_Financial%2BEducation%2B-Define%2Bit-.webp?auto=format,compress\u0026rect=581,0,1539,1539\u0026w=100\u0026h=100","id":"Z_OBYndAxsiBwYT4","edit":{"x":581,"y":0,"zoom":1,"background":"transparent"}}},"content":[{"type":"paragraph","text":"Your credit score is one of the most important parts of your personal finances. Your score will affect everything from your ability to get a credit card to the interest rates you pay on loans. ","spans":[]},{"type":"paragraph","text":"Many factors go into your credit score, but one that’s often overlooked is called “credit mix”. This refers to the variety of types of credit products you use, and it makes up 10% of your credit score. Here’s everything you need to know about types of debt, credit mix, and how to optimize this aspect of your credit rating. ","spans":[]},{"type":"heading2","text":"What Is “Credit Mix”?","spans":[]},{"type":"paragraph","text":"Credit mix is a credit scoring factor that refers to the types of debt and credit products that you have. The types of credit you have might include credit cards, installment loans, and retail accounts, which we’ll touch on more below. ","spans":[]},{"type":"paragraph","text":"Credit mix is important because lenders like to see that you have been responsible with managing a variety of credit types. In general, if you have a wider variety of debt types in your credit report, your score will be higher. If you have only one type of credit, your score may be lower. ","spans":[]},{"type":"heading3","text":"How Much Does Credit Mix Affect Your Credit Score? ","spans":[]},{"type":"paragraph","text":"In the FICO credit scoring model, credit mix makes up 10% of your credit score. The credit scoring factors are:","spans":[]},{"type":"list-item","text":"Payment history - 35% of your credit score","spans":[]},{"type":"list-item","text":"Amounts owed - 30% of your credit score","spans":[]},{"type":"list-item","text":"Credit history length - 15% of your credit score","spans":[]},{"type":"list-item","text":"New credit - 10% of your credit score","spans":[]},{"type":"list-item","text":"Credit mix - 10% of your credit score","spans":[]},{"type":"paragraph","text":"As you can see, credit mix has the smallest overall effect on your score out of any of the factors. Your record of on-time payments and the amounts you owe have a much larger impact on your score.","spans":[]},{"type":"paragraph","text":"With that said, credit mix absolutely still affects your score. It may not be the first priority to optimize, but it should definitely be on your radar if you’re looking to improve your credit rating. ","spans":[]},{"type":"heading2","text":"Types of Debt/Credit","spans":[]},{"type":"paragraph","text":"Credit mix is a measure of the types of credit that you are using or have used in the past. To better understand credit mix, we must first understand the different types of credit that are available. There are two broad categories of debt: Revolving credit and installment credit. Here’s what you need to know. ","spans":[]},{"type":"heading2","text":"Revolving Credit Explained","spans":[]},{"type":"paragraph","text":"Revolving credit is a flexible form of credit that allows you to borrow as needed, and repay as needed. It includes credit cards and certain types of lines of credit. ","spans":[]},{"type":"paragraph","text":"Instead of a large upfront loan with consistent monthly payments, revolving credit gives you the option to borrow and repay on a recurring basis. In other words, the amount you borrow and repay is flexible, and continually adjusts based on your spending and repayment activity. ","spans":[]},{"type":"paragraph","text":"Revolving credit is also flexible in how much you pay. Often there will be a small minimum payment due, with the flexibility to make larger payments to reduce your debt. ","spans":[]},{"type":"heading3","text":"Credit Cards","spans":[]},{"type":"paragraph","text":"Credit cards allow you to make purchases at stores and online using borrowed money. When you open a credit card, you’ll be given a maximum credit limit — $3,000, for example. This means that you can borrow up to $3,000 using the card. ","spans":[]},{"type":"paragraph","text":"If you put $1,000 in charges on the card, your credit limit will decrease to $2,000. If you then make a $500 payment, your credit limit will increase to $2,500. ","spans":[]},{"type":"paragraph","text":"On a credit card, a minimum monthly payment will always be required, but it’s generally a very low amount — often only 1 to 2% of your current balance. You can always pay more (which will help you save money on interest), but you aren’t required to pay any more than the minimum payment. ","spans":[]},{"type":"heading3","text":"Lines of Credit","spans":[]},{"type":"paragraph","text":"A line of credit functions similarly to a credit card. You are given a maximum credit limit, and you can borrow up to that limit as needed.","spans":[]},{"type":"paragraph","text":"Some lines of credit are secured, meaning that they are backed by the value of an asset you own — like your home. Others are unsecured, meaning that they are not backed by an asset. ","spans":[{"start":25,"end":32,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/what-is-an-unsecured-vs-secured-personal-loan"}},{"start":125,"end":134,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/what-is-an-unsecured-vs-secured-personal-loan"}}]},{"type":"heading2","text":"Installment Credit Explained","spans":[]},{"type":"paragraph","text":"Installment credit includes most standard loans. You borrow a set amount and then make monthly repayments in the same amount every month for the length of the loan. ","spans":[]},{"type":"paragraph","text":"You may be able to make extra payments to pay the debt off quicker, but a significant monthly payment will always be needed. You also cannot typically borrow more without applying for a separate loan (unlike revolving credit, where you can continually borrow more as you repay). ","spans":[]},{"type":"heading3","text":"Mortgages","spans":[]},{"type":"paragraph","text":"Mortgages are home loans that you borrow to purchase real estate. These are generally very large loans in the hundreds of thousands of dollars, with monthly payments in the thousands of dollars. ","spans":[]},{"type":"heading3","text":"Auto Loans","spans":[]},{"type":"paragraph","text":"Auto loans are fixed installment loans used to purchase vehicles. They are secured by the value of your vehicle, which means the bank can take ownership of your car if you default on the loan. ","spans":[{"start":0,"end":10,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/6-ways-to-pay-off-your-car-loan-early"}}]},{"type":"heading3","text":"Student Loans","spans":[]},{"type":"paragraph","text":"Student loans are taken out to help pay for higher education costs. Most student loans are federal loans, which are funded by the federal government and applied for via the Free Application for Federal Student Aid (FAFSA).  Private loans, on the other hand, work a bit differently and are separate from federal loans. Student loans are not secured by any physical asset. ","spans":[]},{"type":"heading3","text":"Personal Loans","spans":[]},{"type":"paragraph","text":"Personal loans are generic loans that can be used for a variety of purposes. Borrowers can take out a fixed amount to fund a major purchase, pay down other high-interest debt, or cover a shortfall in their personal budget. Personal loans are generally not secured. ","spans":[{"start":156,"end":174,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/how-to-pay-off-high-interest-debt-guide"}}]},{"type":"heading2","text":"Improving Your Credit Mix Can Improve Your Credit Score — But It’s Not the Only Way","spans":[]},{"type":"paragraph","text":"If you have only one or two types of debt on your credit report, that could be holding your score back a bit. Improving your credit mix may help boost your credit score, but there are many ways to improve your credit without taking on additional debt. ","spans":[{"start":184,"end":216,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/7-tried-and-true-ways-to-improve-your-credit-score"}}]},{"type":"paragraph","text":"In most cases, you shouldn’t take out a loan or apply for a new credit card or line of credit  just to boost your credit score. The downsides of taking on additional debt typically outweigh the small boost you might get from improving your credit mix. ","spans":[{"start":15,"end":126,"type":"strong"},{"start":103,"end":126,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/articles/what-makes-up-your-credit-score"}}]},{"type":"paragraph","text":"Often, focusing on the bigger factors of your credit score can give you a bigger boost, without taking on more debt. For instance, paying down existing debt can help boost your “amounts owed” credit score factor, which is 30% of your score (compared to 10% for credit mix).","spans":[]},{"type":"paragraph","text":"The PayOff Loan™ from Happy Money can help qualified borrowers consolidate credit card debt into a lower-interest personal loan. This can potentially help you pay off your debt faster, reduce interest costs, and boost your credit score. Now that’s a win-win-win! ","spans":[{"start":0,"end":16,"type":"hyperlink","data":{"link_type":"Web","url":"https://happymoney.com/payoff-loan"}}]}],"body":[]}}],"total":78},"globalSiteData":{"banner_message":"If you are a customer that has been impacted by Hurricane Helene, please contact us at \u003ca href=\"tel:1-800-878-0901\"\u003e1-800-878-0901\u003c/a\u003e for assistance. \u003ca href=\"/assistance\"\u003eLearn more\u003c/a\u003e","show_banner":true,"banner_bg_color":"#FFD28F","banner_event_info":null,"header_body":[{"primary":{"dropdown_text":"Personal Loans","dropdown_href":null},"items":[{"link_text":"The Payoff Loan","link_href":"/payoff-loan"},{"link_text":"Getting Approved","link_href":"/getting-approved"},{"link_text":"Rates \u0026 Terms","link_href":"/rates-and-terms"}],"id":"header_dropdown$dc5fa2d3-0d52-4f86-ba31-49fc79f70d72","slice_type":"header_dropdown","slice_label":null},{"primary":{"dropdown_text":"About Us","dropdown_href":null},"items":[{"link_text":"Our Company","link_href":"/company"},{"link_text":"Careers","link_href":"/careers"},{"link_text":"Lending Partners","link_href":"/all-lending-partners"},{"link_text":"Press","link_href":"/press"}],"id":"header_dropdown$32588ad3-ccb3-4c60-8b5c-45d06ff4bef2","slice_type":"header_dropdown","slice_label":null},{"primary":{"dropdown_text":"Resources","dropdown_href":null},"items":[{"link_text":"Debt Consolidation Information","link_href":"/resources/debt-consolidation"},{"link_text":"Personal Loan Information","link_href":"/resources/personal-loans"},{"link_text":"Financial Wellness","link_href":"/resources/financial-wellness"},{"link_text":"Blog","link_href":"/articles"}],"id":"header_dropdown$d4b41086-b27b-4900-bd71-b15a7f039080","slice_type":"header_dropdown","slice_label":null},{"primary":{"dropdown_text":"Support","dropdown_href":"/support"},"items":[],"id":"header_dropdown$34ab7da2-d20f-4705-a55b-780c51c80abf","slice_type":"header_dropdown","slice_label":null}],"legal":[{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"‡‡ Happy Money works with \u003ca href=\"/all-lending-partners\"\u003eLending Partners\u003c/a\u003e who originate loans. Individual borrowers must be at least 18 years old and have a valid social security number and a valid checking account. All loans are subject to credit review and approval. Your actual rate depends upon credit score, loan amount, loan term, credit usage, credit history, and state of residence. Currently, loans are not offered in: IA, MA and NV. Our mailing address is Happy Money, 21515 Hawthorne Blvd, Suite 200, Torrance, CA 90503.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/br\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"* Checking your rate generates a soft credit inquiry that is only visible to you. A hard credit inquiry that can affect your credit score appears when your loan is issued.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/br\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"** Your repayment terms will depend on your interest rate, origination fee, loan amount, and loan term. Example — A loan of $16,000 at 11.84% will result in 48 monthly payments of $408.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/br\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"‡ Happy Money's lending partners offer fixed rates between 7.95% Annual Percentage Rate (APR) and 29.99% APR for loan amounts from $5,000 to $50,000. The minimum rate for loan amounts above $15,000 is 10.84% APR. The minimum loan amount and APR may vary in certain states. Rates depicted are accurate as of August 5, 2025. Please see our \u003ca href=\"/rates-and-terms\"\u003eRates and Terms\u003c/a\u003e page for specific details.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/br\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"† The origination fee is charged by the lender who funds and issues your loan through our platform. Lenders may charge late, bounced check, failed ACH, or other fees. The origination fee is based on your loan amount, term, and credit quality. This one-time fee is deducted from your loan proceeds when your loan is issued.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/br\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"†† Impact to credit score may vary, and some users’ credit scores may not improve. Results depend on many factors including whether your loan payments are on time, the status of your other, non-Happy Money accounts, and financial history.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"}],"footer_body":[{"primary":{},"items":[],"id":"footer_links$48e500ca-4d7c-4453-b4ad-f20d2aaa51ce","slice_type":"footer_links","slice_label":null},{"primary":{},"items":[{"link_text":"Our Company","link_href":null},{"link_text":"Company","link_href":"/company"},{"link_text":"Careers","link_href":"/careers"},{"link_text":"Press","link_href":"/press"}],"id":"footer_links$ea351d74-41a9-4039-8704-aaf111e492c3","slice_type":"footer_links","slice_label":null},{"primary":{},"items":[{"link_text":"Help Center","link_href":null},{"link_text":"Contact Us","link_href":"/contact"},{"link_text":"Support ↗","link_href":"https://happymoney.com/support"},{"link_text":"Opt Out ↗","link_href":"https://cloud.e.happymoney.com/preferences"}],"id":"footer_links$9836923c-e7f6-4faf-9b32-6b2365ef18ac","slice_type":"footer_links","slice_label":null},{"primary":{},"items":[{"link_text":"Legal","link_href":null},{"link_text":"Privacy \u0026 Legal","link_href":"/privacy-and-legal"},{"link_text":"Licenses","link_href":"/lending-licenses"},{"link_text":"All Lending Partners","link_href":"/all-lending-partners"},{"link_text":"Accessibility","link_href":"/contact#accessibility"}],"id":"footer_links$09b9bb62-4cec-4c89-88d3-3fef4030c166","slice_type":"footer_links","slice_label":null},{"primary":{},"items":[{"link_text":"Trust and Security","link_href":"/trust-and-security"},{"link_text":"Privacy Policy","link_href":"/privacy-policy"},{"link_text":"NMLS #1396805 (NMLS Consumer Access ↗)","link_href":"https://nationwidelicensingsystem.org/about/Pages/NMLSConsumerAccess.aspx"}],"id":"footer_copyright_links$816f13c4-cdfb-493a-af88-f8706e482f6f","slice_type":"footer_copyright_links","slice_label":null}],"seo_title":"Happy Money | Personal loans with your best interests at heart","seo_description":"Fund your happy with The Payoff Loan. Lower stress, save on interest, and eliminate credit card balances with a personal loan built for you.","seo_social":{"dimensions":{"width":1280,"height":720},"alt":"Happy Money Social Card","copyright":null,"url":"https://images.prismic.io/point-break/a7974b36-627c-4277-80fb-b3d2b7e7cbe0_HM_Share_Image_Q1-22.png?auto=compress,format","id":"YhR31REAACkAsuE3","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"payoff_footer_legal":[{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"‡‡ Happy Money works with \u003ca href=\"/all-lending-partners\"\u003eLending Partners\u003c/a\u003e who originate loans. Individual borrowers must be at least 18 years old and have a valid social security number and a valid checking account. All loans are subject to credit review and approval. Your actual rate depends upon credit score, loan amount, loan term, credit usage, credit history, and state of residence. Currently loans are not offered in: IA, MA and NV. Our mailing address is: Happy Money, 21515 Hawthorne Blvd, Suite 200, Torrance, CA 90503.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/br\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"‡ Happy Money's lending partners offer fixed rates between 7.95% APR and 29.99% APR for loan amounts from $5,000 to $50,000. The minimum rate for loan amounts above $15,000 is 10.84% APR. The minimum loan amount and APR may vary in certain states. Rates depicted are accurate as of August 5, 2025. Please see our \u003ca href=\"/rates-and-terms\"\u003eRates and Terms\u003c/a\u003e page for specific details.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/br\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"* Checking your rate generates a soft credit inquiry that is only visible to you. A hard credit inquiry that can affect your credit score appears when your loan is issued.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/br\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"** Your repayment terms will depend on your interest rate, origination fee, loan amount, and loan term. Example — A loan of $16,000 at 11.84% will result in 48 monthly payments of $408.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/br\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"† The origination fee is charged by the lender who funds and issues your loan through our platform. Lenders may charge late, bounced check, failed ACH, or other fees. The origination fee is based on your loan amount, term, and credit quality. This one-time fee is deducted from your loan proceeds when your loan is issued.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/br\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"†† Based on a study of Happy Money Customers who received a loan between September 2021 and February 2022. Customers, who paid off at least $5,000 in credit card balances, saw an average increase in their credit score of 49 points within four months of receiving a Payoff Loan. Results may vary and are not guaranteed.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"}],"dm_footer_legal":[{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  ‡‡ Happy Money works with \u003ca href=\"/all-lending-partners\"\u003eLending Partners\u003c/a\u003e who originate loans.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  Individual borrowers must be at least 18 years old and have a valid social security number and a valid","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  checking account. All loans are subject to credit review and approval. Your actual rate depends upon","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  credit score, loan amount, loan term, credit usage, credit history, and state of residence. Currently","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  loans are not offered in: IA, MA and NV. Our mailing address is: Happy Money, 21515 Hawthorne Blvd, Suite 200, Torrance, CA 90503.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"‡ Happy Money's lending partners offer fixed rates between 7.95% APR and 29.99% APR for loan amounts from $5,000 to $50,000. The minimum rate for loan amounts above $15,000 is 10.84% APR. The minimum loan amount and APR may vary in certain states. Rates depicted are accurate as of August 5, 2025. Please see our \u003ca href=\"/rates-and-terms\"\u003eRates and Terms\u003c/a\u003e page for specific details.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"* Checking your rate generates a soft credit inquiry that is only visible to you. A hard credit inquiry that can affect your credit score appears when your loan is issued.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"** Your repayment terms will depend on your interest rate, origination fee, loan amount, and loan term. Example — A loan of $16,000 at 11.84% will result in 48 monthly payments of $408.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"† The origination fee is charged by the lender who funds and issues your loan through our platform. Lenders may charge late, bounced check, failed ACH, or other fees. The origination fee is based on your loan amount, term, and credit quality. This one-time fee is deducted from your loan proceeds when your loan is issued.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"†† Impact to credit score may vary, and some users’ credit scores may not improve. Results depend on many factors including whether your loan payments are on time, the status of your other, non-Happy Money accounts, and financial history.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"}],"dm_footer_legal_legacy_ver":[{"type":"paragraph","text":"\u003cp class=\"single-border underline\"\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  You can choose to stop receiving “prescreened” offers of credit from Happy Money and other companies by","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  calling 1-888-567-8688. See PRESCREEN \u0026 OPT-OUT NOTICE below for more information about prescreened","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  offers.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cdiv class=\"single-border\"\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp class=\"underline\"\u003ePRESCREEN \u0026 OPT OUT NOTICE\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp class=\"underline\"\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"This “prescreened” offer of credit is based on information in your credit report indicating that you meet certain initial creditworthiness criteria of our lending partners. This offer is not guaranteed if you do not continue to meet this criteria. All loans are subject to credit review and approval by our lending partners. Your actual rate depends upon credit score, loan amount, loan term, credit usage, credit history, and state of residence, among other things. If you do not want to receive prescreened offers of credit from Happy Money and other companies, call the consumer credit reporting Agencies at \u003ca href=\"tel:1-888-567-8688\"\u003e1-888-567-8688\u003c/a\u003e or visit the website at \u003ca href=\"https://www.optoutprescreen.com/\" target=\"_blank\"\u003ewww.optoutprescreen.com\u003c/a\u003e; or write to them at TransUnion, PO Box 505, Woodlyn, PA 19094; Equifax, PO Box 740123, Atlanta, GA 30374; Experian, PO Box 919, Allen, TX 75013; Innovis Consumer Assistance, PO Box 495, Pittsburgh, PA 15230. This is a limited time offer and is not transferable.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/div\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  ‡‡ Happy Money works with \u003ca href=\"/all-lending-partners\"\u003eLending Partners\u003c/a\u003e who originate loans.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  Individual borrowers must be at least 18 years old and have a valid social security number and a valid","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  checking account. All loans are subject to credit review and approval. Your actual rate depends upon","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  credit score, loan amount, loan term, credit usage, credit history, and state of residence. Currently","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  loans are not offered in: IA, MA and NV. Our mailing address is: Happy Money, 21515 Hawthorne Blvd, Suite 200, Torrance, CA 90503.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"‡ Happy Money's lending partners offer fixed rates between 7.95% APR and 29.99% APR for loan amounts from $5,000 to $40,000. The minimum rate for loan amounts above $15,000 is 10.84% APR. The minimum loan amount and APR may vary in certain states. Rates depicted are accurate as of August 5, 2025. Please see our \u003ca href=\"/rates-and-terms\"\u003eRates and Terms\u003c/a\u003e page for specific details.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"* Checking your rate generates a soft credit inquiry that is only visible to you. A hard credit inquiry that can affect your credit score appears when your loan is issued.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"** Your repayment terms will depend on your interest rate, origination fee, loan amount, and loan term. Example — A loan of $16,000 at 12.63% APR will have a $520 origination fee and a monthly payment of $412 for 48 months.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"† The origination fee is charged by the lender who funds and issues your loan through our platform. Lenders do not charge any late, bounced check, failed ACH, or other fees. The origination fee is based on your loan amount, term, and credit quality. This one-time fee is deducted from your loan proceeds when your loan is issued.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"†† Based on a study of Happy Money Customers who received a loan between September 2021 and February 2022. Customers, who paid off at least $5,000 in credit card balances, saw an average increase in their credit score of 49 points within four months of receiving a Payoff Loan. Results may vary and are not guaranteed.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"§ According to a \u003ca href=\"https://www.lendingtree.com/credit-cards/average-credit-card-interest-rate-in-america/\" target=\"_blank\"\u003ereview\u003c/a\u003e by LendingTree as of November 17, 2023, \"[i]n November 2023, more than 1 in 3 cards (36%) reviewed had possible APRs of 29.99% or higher\".","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"}],"affiliate_logos":[{"affiliate_logo":{"dimensions":{"width":2024,"height":526},"alt":"Credit Karma","copyright":null,"url":"https://images.prismic.io/point-break/Z5E6HJbqstJ99v-A_IC-Logo_Karma-Green_RGB.png?auto=format,compress","id":"Z5E6HJbqstJ99v-A","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"credit-karma","max_width":184},{"affiliate_logo":{"dimensions":{"width":2024,"height":526},"alt":"Credit Karma Lightbox","copyright":null,"url":"https://images.prismic.io/point-break/Z5E6HJbqstJ99v-A_IC-Logo_Karma-Green_RGB.png?auto=format,compress","id":"Z5E6HJbqstJ99v-A","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"credit-karma-lightbox","max_width":184},{"affiliate_logo":{"dimensions":{"width":199,"height":59},"alt":"NerdWallet","copyright":null,"url":"https://point-break.cdn.prismic.io/point-break/3ef08062-b711-4905-b355-adc3a4a9b47c_NerdWallet+Logo.svg","id":"YvKJ8BYAAC8ANIRP","edit":{"x":0,"y":0,"zoom":1,"background":"#fff"}},"id":"nerdwallet","max_width":null},{"affiliate_logo":{"dimensions":{"width":300,"height":172},"alt":"Monevo","copyright":null,"url":"https://images.prismic.io/point-break/ZzMDHa8jQArT0uGf_monevo.png?auto=format,compress","id":"ZzMDHa8jQArT0uGf","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"monevo","max_width":160},{"affiliate_logo":{"dimensions":{"width":660,"height":178},"alt":"WalletHub","copyright":null,"url":"https://images.prismic.io/point-break/ZzMDTq8jQArT0uGi_wallethub.png?auto=format,compress","id":"ZzMDTq8jQArT0uGi","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"wallethub","max_width":null},{"affiliate_logo":{"dimensions":{"width":589,"height":116},"alt":"SuperMoney","copyright":null,"url":"https://images.prismic.io/point-break/ZzMDrq8jQArT0uGq_super-money.png?auto=format,compress","id":"ZzMDrq8jQArT0uGq","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"supermoney","max_width":null},{"affiliate_logo":{"dimensions":{"width":447,"height":88},"alt":"Guide To Lenders","copyright":null,"url":"https://images.prismic.io/point-break/ZzMDra8jQArT0uGp_guide-to-lenders.png?auto=format,compress","id":"ZzMDra8jQArT0uGp","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"guide-to-lenders","max_width":null},{"affiliate_logo":{"dimensions":{"width":787,"height":160},"alt":"CreditSesame","copyright":null,"url":"https://images.prismic.io/point-break/ZzMDr68jQArT0uGr_creditsesame.png?auto=format,compress","id":"ZzMDr68jQArT0uGr","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"creditsesame","max_width":null},{"affiliate_logo":{"dimensions":{"width":1389,"height":363},"alt":"CreditSnap","copyright":null,"url":"https://images.prismic.io/point-break/Zzvc268jQArT1Afv_credit-snap.png?auto=format,compress","id":"Zzvc268jQArT1Afv","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"creditsnap","max_width":null},{"affiliate_logo":{"dimensions":{"width":340,"height":124},"alt":"LendingTree","copyright":null,"url":"https://images.prismic.io/point-break/Zz_Odq8jQArT1JaS_lending-tree.png?auto=format,compress","id":"Zz_Odq8jQArT1JaS","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"lendingtree","max_width":null},{"affiliate_logo":{"dimensions":{"width":320,"height":117},"alt":"Decimal Logo","copyright":null,"url":"https://images.prismic.io/point-break/aAlxwfIqRLdaBjDR_DecimalLogoPNGBlack.png?auto=format,compress","id":"aAlxwfIqRLdaBjDR","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"decimal","max_width":null},{"affiliate_logo":{"dimensions":{"width":3000,"height":842},"alt":"Budge Logo","copyright":null,"url":"https://images.prismic.io/point-break/aC0clSdWJ-7kSX84_BudgeLogo%403x.png?auto=format,compress","id":"aC0clSdWJ-7kSX84","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"budge","max_width":null},{"affiliate_logo":{"dimensions":{"width":8001,"height":2260},"alt":"Wisepal Logo","copyright":null,"url":"https://images.prismic.io/point-break/aEk6cLNJEFaPX2xG_WisePalLogo.png?auto=format,compress","id":"aEk6cLNJEFaPX2xG","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"wisepal","max_width":null},{"affiliate_logo":{"dimensions":{"width":50,"height":50},"alt":"Transunion/Credit Sesame Logo","copyright":null,"url":"https://point-break.cdn.prismic.io/point-break/aIqYqaTt2nPbZlU5_TU_stamp-blue.svg","id":"aIqYqaTt2nPbZlU5","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"transunion/credit-sesame","max_width":null},{"affiliate_logo":{"dimensions":{"width":1200,"height":1200},"alt":"Acqscale Logo","copyright":null,"url":"https://images.prismic.io/point-break/aMCPvWGNHVfTO28d_IMG_3444.png?auto=format,compress","id":"aMCPvWGNHVfTO28d","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"acqscale","max_width":null},{"affiliate_logo":{"dimensions":{"width":9927,"height":1953},"alt":"Apriority logo","copyright":null,"url":"https://images.prismic.io/point-break/aMM682GNHVfTPEXl_apriority_logo.png?auto=format,compress","id":"aMM682GNHVfTPEXl","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"id":"apriority","max_width":null}],"landing_footer_legal":[{"type":"paragraph","text":"\u003cp class=\"single-border underline\"\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  You can choose to stop receiving “prescreened” offers of credit from Happy Money and other companies by","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  calling 1-888-567-8688. See PRESCREEN \u0026 OPT-OUT NOTICE below for more information about prescreened","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  offers.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cdiv class=\"single-border\"\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp class=\"underline\"\u003ePRESCREEN \u0026 OPT OUT NOTICE\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp class=\"underline\"\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"    This “prescreened” offer of credit is based on information in your credit report indicating that you","spans":[],"direction":"ltr"},{"type":"paragraph","text":"    meet certain criteria. This offer is not guaranteed if you do not meet our criteria. If you do not","spans":[],"direction":"ltr"},{"type":"paragraph","text":"    want to receive prescreened offers of credit from Happy Money and other companies, call the consumer","spans":[],"direction":"ltr"},{"type":"paragraph","text":"    credit reporting agencies at \u003ca href=\"tel:1-888-567-8688\"\u003e1-888-567-8688\u003c/a\u003e or visit the website at ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003ca href=\"https://www.optoutprescreen.com/\" target=\"_blank\"\u003ewww.optoutprescreen.com\u003c/a\u003e; or write to","spans":[],"direction":"ltr"},{"type":"paragraph","text":"    them at TransUnion PO Box 505, Woodlyn, PA 19094-0505; Equifax, PO Box 740123, Atlanta, GA 30374;","spans":[],"direction":"ltr"},{"type":"paragraph","text":"    Experian, PO Box 919, Allen, TX 75013; Innovis Consumer Assistance, PO Box 495, Pittsburgh, PA 15230","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/div\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  ‡‡ Happy Money works with \u003ca href=\"/all-lending-partners\"\u003eLending Partners\u003c/a\u003e who originate loans.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  Individual borrowers must be at least 18 years old and have a valid social security number and a valid","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  checking account. All loans are subject to credit review and approval. Your actual rate depends upon","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  credit score, loan amount, loan term, credit usage, credit history, and state of residence. Currently","spans":[],"direction":"ltr"},{"type":"paragraph","text":"  loans are not offered in: IA, MA and NV. Our mailing address is: Happy Money, 21515 Hawthorne Blvd, Suite 200, Torrance, CA 90503.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"‡ Happy Money's lending partners offer fixed rates between 7.95% APR and 29.99% APR for loan amounts from $5,000 to $50,000. The minimum rate for loan amounts above $15,000 is 10.84% APR. The minimum loan amount and APR may vary in certain states. Rates depicted are accurate as of August 5, 2025. Please see our \u003ca href=\"/rates-and-terms\"\u003eRates and Terms\u003c/a\u003e page for specific details.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"* Checking your rate generates a soft credit inquiry that is only visible to you. A hard credit inquiry that can affect your credit score appears when your loan is issued.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"** Your repayment terms will depend on your interest rate, origination fee, loan amount, and loan term. Example — A loan of $16,000 at 12.63% APR will have a $520 origination fee and a monthly payment of $412 for 48 months.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"† The origination fee is charged by the lender who funds and issues your loan through our platform. Lenders may charge late, bounced check, failed ACH, or other fees. The origination fee is based on your loan amount, term, and credit quality. This one-time fee is deducted from your loan proceeds when your loan is issued.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cbr /\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003cp\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"†† Based on a study of Happy Money Customers who received a loan between September 2021 and February 2022. Customers, who paid off at least $5,000 in credit card balances, saw an average increase in their credit score of 49 points within four months of receiving a Payoff Loan. Results may vary and are not guaranteed.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"\u003c/p\u003e","spans":[],"direction":"ltr"},{"type":"paragraph","text":"","spans":[],"direction":"ltr"}],"cu_landing_footer":[{"cu_name":"alliant","cu_landing_footer_legal":[{"type":"paragraph","text":"\u003cp\u003e","spans":[]},{"type":"paragraph","text":"* National average based on 1-year CD yield, Bankrate.com \u003ca href=\"https://www.bankrate.com/banking/cds/current-cd-interest-rates/\" target=\"_blank\"\u003e\"Current CD rates for November 2023\"\u003c/a\u003e","spans":[]},{"type":"paragraph","text":"\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003c/br\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e","spans":[]},{"type":"paragraph","text":"† APY= Annual Percentage Yield. The APY is accurate as of the 11/1/2023 dividend declaration date. A $1000.00 minimum deposit is required to open a Regular Alliant Certificate. A $75,000 minimum deposit is required to open an Alliant Jumbo Certificate. If you open an Alliant Jumbo Certificate with a minimum deposit of $75,000, but later withdraw funds from the account and bring the balance below $75,000, the Alliant Jumbo Certificate will convert to a Regular Alliant Certificate, which may pay a lower rate. You must be an Alliant member. Alliant Certificates are available as Regular Share Certificates and, Jumbo Share Certificates. Both Regular and Jumbo Certificate types are also offered as Traditional IRA Certificates, Roth IRA Certificates, and SEP IRA Certificates. In addition, prior to opening an IRA Certificate (Traditional, Roth and SEP), you must have or establish an IRA with Alliant. You may not add any additional money to your Certificate after opening. Dividends compound monthly and are paid on the last day of the month and at maturity. There are no penalties for monthly dividend withdrawals. Early withdrawal penalties do apply if the Certificate is closed before the maturity date unless the Certificate funds are moved to Alliant Retirement and Investment Services. If you wish to move your Certificate funds to Alliant Retirement and Investment Services, you must wait until 7 days after your Certificate has been opened. Other exceptions to early withdrawal penalties may be allowed. Monthly dividend withdrawals are not eligible on IRA Certificates if owner is under age 59 1/2. Any monthly withdrawals or transfers reduce earnings. If you change the term of your renewed Certificate, the beneficiary(ies) need(s) to be reestablished by completing a Beneficiary Add/Delete Form. (Not applicable to IRA Certificates). The joint owner designated at the time of Certificate opening will remain as joint owner if you renew your Certificate with Alliant. Neither the primary account owner or joint owner may be a beneficiary on the Certificate account. You are not locked into a rate until you open or renew your Alliant Certificate. Alliant Certificate rates may change daily. Fees may reduce earnings on the account.","spans":[]},{"type":"paragraph","text":"\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003c/br\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e\u003cb\u003e6-11 months\u003c/b\u003e\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e","spans":[]},{"type":"paragraph","text":"Regular Share Certificates with a term between 6 and 11 months provide a Dividend Rate of 4.65% – Compounded Annual Percentage Yield of 4.75% APY on balances between $1,000 and $74,999.99. Jumbo Share Certificates with a term between 6 and 11 months provide a Dividend Rate of 4.65% – Compounded Annual Percentage Yield of 4.75% APY on balances $75,000 or greater. IRA Certificates with a term between 6 and 11 months provide a Dividend Rate of 4.65% – Compounded Annual Percentage Yield of 4.75% APY on balances between $1,000 and $74,999.99. Jumbo IRA Certificates with a term between 6 and 11 months provide a Dividend Rate of 4.65% – Compounded Annual Percentage Yield of 4.75% APY on balances $75,000 or greater.","spans":[]},{"type":"paragraph","text":"\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003c/br\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e\u003cb\u003e12-17 months\u003c/b\u003e\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e","spans":[]},{"type":"paragraph","text":"Regular Share Certificates with a term between 12 and 17 months provide a Dividend Rate of 5.13% – Compounded Annual Percentage Yield of 5.25% APY on balances between $1,000 and $74,999.99. Jumbo Share Certificates with a term between 12 and 17 months provide a Dividend Rate of 5.18% – Compounded Annual Percentage Yield of 5.30% APY on balances $75,000 or greater. IRA Certificates with a term between 12 and 17 months provide a Dividend Rate of 5.13% – Compounded Annual Percentage Yield of 5.25% APY on balances between $1,000 and $74,999.99. Jumbo IRA Certificates with a term between 12 and 17 months provide a Dividend Rate of 5.18% – Compounded Annual Percentage Yield of 5.30% APY on balances $75,000 or greater.","spans":[]},{"type":"paragraph","text":"\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003c/br\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e\u003cb\u003e18-23 months\u003c/b\u003e\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e","spans":[]},{"type":"paragraph","text":"Regular Share Certificates with a term between 18 and 23 months provide a Dividend Rate of 5.18% – Compounded Annual Percentage Yield of 5.30% APY on balances between $1,000 and $74,999.99. Jumbo Share Certificates with a term between 18 and 23 months provide a Dividend Rate of 5.22% – Compounded Annual Percentage Yield of 5.35% APY on balances $75,000 or greater. IRA Certificates with a term between 18 and 23 months provide a Dividend Rate of 5.18% – Compounded Annual Percentage Yield of 5.30% APY on balances between $1,000 and $74,999.99. Jumbo IRA Certificates with a term between 18 and 23 months provide a Dividend Rate of 5.22% – Compounded Annual Percentage Yield of 5.35% APY on balances $75,000 or greater.","spans":[]},{"type":"paragraph","text":"\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003c/br\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e","spans":[]},{"type":"paragraph","text":"\u003cb\u003eDeposit product is offered by Alliant Credit Union and not affiliated with Happy Money.\u003c/b\u003e","spans":[]},{"type":"paragraph","text":"\u003c/p\u003e","spans":[]}]},{"cu_name":"msufcu","cu_landing_footer_legal":[{"type":"paragraph","text":"\u003cp\u003e","spans":[]},{"type":"paragraph","text":"* National average based on 1-year CD yield, Bankrate.com \u003ca href=\"https://www.bankrate.com/banking/cds/current-cd-interest-rates/\" target=\"_blank\"\u003e\"Current CD rates for November 2023\"\u003c/a\u003e","spans":[]},{"type":"paragraph","text":"\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003c/br\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e","spans":[]},{"type":"paragraph","text":"† APY= Annual Percentage Yield. Annual Percentage Yield is the total amount of dividends paid on an account, based on the dividend rate and the frequency of monthly compounding for a 365-day period, and expressed as a percentage. This rate assumes that a set amount is on deposit at the beginning of the dividend period, that no deposits or withdrawals are made during the dividend period and funds remain on deposit for one full year at the same dividend rate. Fees may reduce earnings. A fee may be charged for early withdrawal of a fixed-term certificate or IRA.","spans":[]},{"type":"paragraph","text":"\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003c/br\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e","spans":[]},{"type":"paragraph","text":"Certificate penalties for early withdrawals: Certificates of 13 months to five years: Results in penalty equal to 180 days dividends based on amount withdrawn. If the dividend is not sufficient to cover the penalty, the principal amount will be reduced to cover this amount. The above penalties will not be charged after death of an owner of a Certificate.","spans":[]},{"type":"paragraph","text":"\u003c/p\u003e","spans":[]},{"type":"paragraph","text":"\u003c/br\u003e","spans":[]},{"type":"paragraph","text":"\u003cp\u003e","spans":[]},{"type":"paragraph","text":"\u003cb\u003eDeposit product is offered by Michigan State University Federal Credit Union and not affiliated with Happy Money.\u003c/b\u003e","spans":[]},{"type":"paragraph","text":"\u003c/p\u003e","spans":[]}]}]},"realTimeData":{"emergency_banner_message":[{"type":"paragraph","text":"Notice: You may have received erroneous emails from Happy Money due to testing of new platform updates. Your account remains unaffected. Please disregard these emails. For questions about recent payments, please contact 1-800-878-0901. We apologize for any inconvenience.","spans":[{"start":0,"end":6,"type":"strong"},{"start":220,"end":234,"type":"hyperlink","data":{"link_type":"Web","url":"tel:1-800-878-0901"}}]}],"emergency_banner_show":false,"contact_us_banner_message":[{"type":"paragraph","text":"Emails sent to us from May 19th - 23rd may not have been received due to a technical error. This issue has now been resolved. If you haven't received a response to your inquiry, kindly reach out to us again. We apologize for any inconvenience.","spans":[]}],"contact_us_banner_show":false},"__N_SSG":true},"page":"/articles","query":{},"buildId":"0PuNEOXwXyJv6MvzB52Ko","isFallback":false,"gsp":true,"appGip":true,"scriptLoader":[]}</script><script>(function(){function c(){var b=a.contentDocument||a.contentWindow.document;if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'9b749083fdd824ba',t:'MTc2NzI5NzIyNA=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body></html>